+                          ninfer::ChatRole::Tool, ninfer::ChatRole::User}) {
+        ninfer::ChatMessage message; message.role = role;
+        message.parts.push_back({.kind = ninfer::MessagePartKind::Text,
+            .text = role == ninfer::ChatRole::Tool ? "stored result" : "question", .media = {}});
+        if (role == ninfer::ChatRole::Assistant)
+            message.tool_calls.push_back({.id = "call1", .name = "lookup", .arguments_json = "{}"});
+        if (role == ninfer::ChatRole::Tool) message.tool_call_id = "call1";
+        input.messages.push_back(std::move(message));
+    }
+    const auto prepared = frontend.prepare(input);
+    const auto repeated = frontend.prepare(input);
+    const auto& data = FrontendFactory::inspect(prepared);
+    int failures = check(data.source_configuration != kvmem::SourceConfiguration{} &&
+        data.source_configuration == FrontendFactory::inspect(repeated).source_configuration,
+        "source input configuration is missing or unstable");
+    bool tool = false;
+    std::uint64_t previous = 0;
+    for (const auto& event : data.source_events) {
+        failures += check(event.id && event.begin >= previous && event.begin < event.end &&
+            event.end <= data.token_ids.size(), "source event is outside exact frontend token boundaries");
+        previous = event.end;
+        tool |= event.kind == kvmem::SourceEventKind::ToolResult;
+    }
+    failures += check(tool, "real Tool input lost its source provenance");
+    const auto raw = frontend.prepare_tokens({0, 0, 0});
+    const auto& raw_data = FrontendFactory::inspect(raw);
+    failures += check(raw_data.source_configuration != data.source_configuration &&
+        raw_data.source_events.size() == 1 && raw_data.source_events[0].kind == kvmem::SourceEventKind::RawInput,
+        "raw token input was confused with chat/control provenance");
+    const auto altered = make_frontend(resources(thinking_toggle_template_source() + "\n"), options).prepare(input);
