@@ -0,0 +1,129 @@
+#include "models/qwen3_5/program/program_impl.h"
+#include "models/qwen3_5/frontend/digest.h"
+
+#include <bit>
+#include <cstdio>
+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+kvmem::SourceConfiguration configuration(const ProgramImpl& program, const PreparedPromptData& prompt) {
+    // Explicit little-endian scalar encoding: no struct padding, pointer values,
+    // std::hash or source byte positions masquerading as computation identity.
+    std::array<std::uint8_t, 512> bytes{};
+    std::size_t used = 0;
+    const auto byte = [&](std::uint8_t x) {
+        if (used == bytes.size()) throw std::logic_error("source configuration encoding overflow");
+        bytes[used++] = x;
+    };
+    const auto integer = [&](std::uint64_t x) { for (int i = 0; i < 8; ++i) byte(std::uint8_t(x >> (8 * i))); };
+    for (const char x : std::string_view("ninfer/qwen3.5/text-source-configuration/v1")) byte(std::uint8_t(x));
+    for (auto x : program.parameters.model.info().artifact_id) byte(std::to_integer<std::uint8_t>(x));
+    for (auto x : prompt.source_configuration) byte(x);
+    integer(std::uint64_t(program.kv_storage)); integer(std::uint64_t(program.speculative_backend));
+    integer(program.capacity); integer(program.prefill_chunk); integer(program.fast_prefill_kernel);
+    integer(program.use_cuda_graph); integer(program.draft_window); integer(program.ngram_draft_window);
+    integer(program.mtp_attention_window);
+    integer(std::bit_cast<std::uint32_t>(program.rope_yarn.factor));
+    integer(program.rope_yarn.native_context);
+    integer(std::bit_cast<std::uint32_t>(program.rope_yarn.interpolation_factor));
+    integer(program.rope_yarn.interpolation_threshold);
+    const auto& m = program.kvmem_options;
+    for (auto value : {std::uint64_t(m.selected_tokens), std::uint64_t(m.reserve_tokens),
+        std::uint64_t(m.sink_tokens), std::uint64_t(m.recent_tokens),
+        std::uint64_t(m.query_replay_max_tokens), std::uint64_t(m.query_max_tokens),
+        std::uint64_t(m.query_meanq_cosine), std::uint64_t(m.score_agg_max), std::uint64_t(m.lrfu),
+        std::uint64_t(m.historical_gc_lru), std::uint64_t(m.historical_gc_redundancy),
+        std::bit_cast<std::uint64_t>(m.lrfu_lambda), std::bit_cast<std::uint64_t>(m.lrfu_top_fraction),
+        std::bit_cast<std::uint64_t>(m.graph_alpha)}) integer(value);
+    return frontend::sha256(std::span<const std::uint8_t>(bytes).first(used));
+}
+
+// Diagnostic only. Hash the actual journal rows, not the input/ledger pointer.
+// Source identity and checkpoint permission never depend on this FNV digest.
+std::uint64_t hash_rows(const kvmem::SourceJournalStore& store, kvmem::SourceRef ref,
+                       std::uint64_t begin, std::uint64_t end, std::uint64_t hash,
+                       std::span<const TokenId> expected = {}) {
+    std::array<std::int32_t, 64> rows{};
+    std::size_t compared = 0;
+    if (!expected.empty() && expected.size() != end - begin)
+        throw std::logic_error("source verification span has the wrong length");
+    while (begin < end) {
+        const auto count = std::min<std::uint64_t>(rows.size(), end - begin);
+        store.read_tokens(ref, begin, rows.data(), std::size_t(count));
+        if (!expected.empty() && !std::equal(rows.begin(), rows.begin() + count, expected.begin() + compared))
+            throw std::logic_error("accepted source row verification failed");
+        for (std::size_t i = 0; i < count; ++i)
+            for (unsigned b = 0; b < 4; ++b)
+                hash = (hash ^ std::uint8_t(std::uint32_t(rows[i]) >> (8 * b))) * 1099511628211ULL;
+        begin += count;
+        compared += std::size_t(count);
+    }
+    return hash;
+}
+}
+
+void ProgramImpl::capture_source(SequenceState& sequence, RequestControl& request) {
+    if (!source_journal || request.source.source.id) return;
+    if (!request.prefill) throw std::logic_error("source capture lost prepared input");
+    const auto& prompt = request.prefill->prompt;
+    const auto count = prompt.token_ids.size();
+    if (prompt.has_media() || !prompt.graft_name.empty() || prompt.rope_delta ||
+        prompt.token_types.size() != count || prompt.positions.size() != 3 * count ||
+        prompt.source_configuration == kvmem::SourceConfiguration{})
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported, "source recording requires prepared plain text rows");
+    for (std::size_t i = 0; i < count; ++i) {
+        if (prompt.token_types[i] != 0) throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported, "source recording lacks media row assets");
+        for (std::size_t axis = 0; axis < 3; ++axis)
+            if (prompt.positions[axis * count + i] != std::int32_t(i))
+                throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported, "source recording lacks custom position rows");
+    }
+    // Admission already owns this complete prepared input. Source acceptance
+    // does not imply that all its KV has executed; computed frontier is separate.
+    const auto ref = source_journal->capture(configuration(*this, prompt), prompt.token_ids.data(), count,
+        prompt.source_events.data(), prompt.source_events.size(), sequence.text_kv_valid);
+    const auto state = source_journal->state(ref);
+    const auto digest = hash_rows(*source_journal, ref, 0, state.accepted_frontier, 14695981039346656037ULL,
+        kvmem_options.verify_transfers ? std::span<const TokenId>(prompt.token_ids) : std::span<const TokenId>{});
+    request.source = sequence.window.source = ref;
+    source_last = state; source_last_tokens_fnv1a64 = digest;
+    if (kvmem_options.verify_transfers)
+        std::fprintf(stderr, "KVMEM_SOURCE_CAPTURE id=%llu accepted=%llu computed=%llu events=%llu\n",
+            (unsigned long long)ref.source.id, (unsigned long long)state.accepted_frontier,
+            (unsigned long long)state.computed_frontier, (unsigned long long)state.events);
+}
+
+void ProgramImpl::record_source_progress(SequenceState& sequence, RequestControl& request,
+    bool accepted_output, kvmem::SourceEventKind kind, bool terminal) {
+    if (!source_journal || !request.source.source.id) return;
+    const auto old = source_journal->state(request.source);
+    const auto end = accepted_output ? std::uint64_t(sequence.ledger_frontier) : old.accepted_frontier;
+    const auto computed = accepted_output ? sequence.execution_frontier : sequence.text_kv_valid;
+    if (end < old.accepted_frontier || end > sequence.ledger.size() || computed > end)
+        throw std::logic_error("source commit disagrees with accepted Program frontier");
+    if (end == old.accepted_frontier && computed == old.computed_frontier) return;
+    std::array<kvmem::SourceEvent, 2> events{};
+    std::size_t count = 0;
+    if (end > old.accepted_frontier) {
+        kvmem::SourceEvent previous{};
+        if (old.events) previous = source_journal->event(request.source, old.events - 1);
+        if (old.events && !previous.complete && previous.kind == kind) {
+            previous.end = end; previous.complete = terminal;
+            events[count++] = previous;
+        } else {
+            if (old.events && !previous.complete) {
+                previous.complete = true; events[count++] = previous;
+            }
+            events[count++] = {previous.id + 1, old.accepted_frontier, end, kind, terminal};
+        }
+    }
+    const auto ref = source_journal->append(request.source,
+        sequence.ledger.data() + old.accepted_frontier, std::size_t(end - old.accepted_frontier),
+        events.data(), count, computed);
+    const auto state = source_journal->state(ref);
+    const auto digest = hash_rows(*source_journal, ref, old.accepted_frontier, end, source_last_tokens_fnv1a64,
+        kvmem_options.verify_transfers ? std::span<const TokenId>(sequence.ledger).subspan(
+            old.accepted_frontier, end - old.accepted_frontier) : std::span<const TokenId>{});
+    request.source = sequence.window.source = ref;
+    source_last = state; source_last_tokens_fnv1a64 = digest;
+}
