+    }
+    require(mode=="replay","unknown replay mode");
+    rejected(kvmem::MemoryErrorCode::BudgetExceeded,[&] { (void)engine.prepare_source_rebuild(source,prefix,32); });
+    rejected(kvmem::MemoryErrorCode::BudgetExceeded,[&] { (void)engine.prepare_source_replay(source,prefix,65536); });
+    auto stale=source;++stale.revision;
+    rejected(kvmem::MemoryErrorCode::Stale,[&] { (void)engine.prepare_source_replay(stale,prefix,32); });
+    rejected(kvmem::MemoryErrorCode::BudgetExceeded,[&] { (void)engine.generate(engine.prepare_source_replay(source,prefix,32),request(64)); });
+    require(engine.historical_sources().size()==1 && engine.memory_summary().kvmem.recovery_bytes==0,"refused replay partially published");
+    const auto result=engine.generate(engine.prepare_source_replay(source,prefix,32),request());
+    require(!result.reused_prompt_tokens && result.computed_prompt_tokens>=prefix && result.accepted_source,"long replay skipped source computation");
+    require(result.generated_token_ids==metadata.at("ids").get<std::vector<ninfer::TokenId>>(),"long replay differs from independent fresh raw-input execution");
+    require(!mtp || result.speculative.rounds>0,"long MTP replay fell back");
+    records=engine.historical_sources();
+    const auto rebuilt=std::find_if(records.begin(),records.end(),[&](const auto& s) {return s.ref==*result.accepted_source;});
+    require(rebuilt!=records.end() && rebuilt->parent==source && rebuilt->parent_prefix_tokens==prefix &&
+        rebuilt->computed_tokens>=prefix && rebuilt->retained_native_domains==1 && rebuilt->retired_native_pages>0,"long replay did not publish a fresh retired-page domain");
+    require(engine.memory_summary().kvmem.recovery_bytes==0,"successful replay retained R");
+    CancelAcrossWindows sink(engine,source);
+    auto active=engine.submit(engine.prepare_source_replay(source,prefix,32),request(),ninfer::OutputConsumerMode::Streaming,{.prompt_progress=true});
+    const auto cancelled=active.wait(&sink,ninfer::CancellationView([&] {return sink.cancel.load(std::memory_order_acquire);}));
+    require(sink.processed>=4096 && cancelled.finish_reason==ninfer::FinishReason::Cancelled && cancelled.computed_prompt_tokens<prefix && cancelled.accepted_source,
+        "actual cancellation across windows missing");
+    records=engine.historical_sources();
+    const auto partial=std::find_if(records.begin(),records.end(),[&](const auto& s) {return s.ref==*cancelled.accepted_source;});
+    require(partial!=records.end() && partial->parent==source && partial->accepted_tokens==prefix && partial->computed_tokens<prefix && !partial->retained_native_domains,
+        "partial replay published reusable native state");
+    auto revoked=engine.prepare_source_replay(source,prefix,32);
+    const auto native_count=std::count_if(records.begin(),records.end(),[](const auto& s) {return s.retained_native_domains!=0;});
+    require(records.size()==3 && engine.memory_summary().kvmem.recovery_bytes==prefix*4ULL,"replay source/R lifecycle inconsistent");
+    const auto forgotten=engine.forget_historical_source(source);
+    require(forgotten.forgotten_sources==3 && forgotten.forgotten_archives==1 && forgotten.discarded_native_domains==native_count,"long family forget missed online or persistent owner");
+    require(engine.historical_sources().empty() && engine.memory_summary().kvmem.recovery_bytes==prefix*4ULL,"forget refunded live R early");
+    rejected(kvmem::MemoryErrorCode::Stale,[&] { (void)engine.generate(std::move(revoked),request()); });
+    require(engine.memory_summary().kvmem.recovery_bytes==0 && engine.is_available(),"revoked long preparation leaked or poisoned Engine");
+    require(engine.generate(engine.prepare_tokens(std::vector<ninfer::TokenId>(128,token)),request()).generated_token_ids.size()==8,"post-replay followup failed");
+    std::cout<<nlohmann::json{{"status","passed"},{"mode",mode},{"mtp",mtp},{"redundancy",redundancy},{"prefix",prefix},
+        {"output_ids",result.generated_token_ids},{"computed_prompt_tokens",result.computed_prompt_tokens},
+        {"speculative_rounds",result.speculative.rounds},{"cancel_processed",sink.processed},{"forgotten_sources",forgotten.forgotten_sources},
+        {"discarded_domains",forgotten.discarded_native_domains}}<<std::endl;return 0;
+}
+}
+int main(int argc,char** argv) {try {return run(argc,argv);}catch(const std::exception& e) {std::cerr<<"SOURCE_REPLAY_FATAL: "<<e.what()<<std::endl;return 1;}}
