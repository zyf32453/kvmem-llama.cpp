+    if (mode=="r-pressure") {
+        {auto held=engine.prepare_source_replay(source,prefix,32);
+         require(engine.memory_summary().kvmem.recovery_bytes==prefix*4ULL,"long R preparation not charged");
+         rejected(kvmem::MemoryErrorCode::BudgetExceeded,[&] { (void)engine.prepare_source_replay(source,prefix,32); });}
+        require(engine.memory_summary().kvmem.recovery_bytes==0 && engine.historical_sources().size()==1 && engine.is_available(),"R refusal leaked or published a source");
