+
+namespace {
+constexpr std::uint32_t prefix=32768;
+void require(bool value,const char* message) { if (!value) throw std::runtime_error(message); }
+template<class F> void rejected(kvmem::MemoryErrorCode code,F work) {
+    try { work(); } catch(const kvmem::MemoryError& e) { require(e.code()==code,"wrong replay refusal");return; }
+    throw std::runtime_error("replay operation unexpectedly succeeded");
+}
+ninfer::RequestOptions request(std::uint32_t tokens=8) {
+    ninfer::RequestOptions r;r.execution.requested_output_tokens=tokens;
+    r.execution.sampling.temperature=0;r.execution.sampling.seed=42;
+    r.execution.thinking.loop=ninfer::ReasoningLoopAction::Off;r.stop.include_model_defaults=false;
+    r.output.raw=r.output.preserve_special_tokens=true;return r;
+}
+struct CancelAcrossWindows final : ninfer::OutputSink {
+    std::atomic<bool> cancel{false};std::uint32_t processed=0;
+    ninfer::Engine& engine;ninfer::HistoricalSourceRef source;
+    CancelAcrossWindows(ninfer::Engine& e,ninfer::HistoricalSourceRef s):engine(e),source(s){}
+    void start(ninfer::GenerationStart s) override { require(!s.reused_prompt_tokens,"cancel replay reused old state"); }
+    void progress(ninfer::PromptProgress p) override {
+        if (!cancel.load() && p.processed_prompt_tokens>=4096 && p.processed_prompt_tokens<p.total_prompt_tokens) {
+            rejected(kvmem::MemoryErrorCode::Pending,[&] { (void)engine.forget_historical_source(source); });
+            processed=p.processed_prompt_tokens;cancel.store(true,std::memory_order_release);
+        }
+    }
+    void timing(ninfer::GenerationTimingObservation) override {}
+    void publish(ninfer::OutputDelta) override {}
+};
+int run(int argc,char** argv) {
+    const char* model=std::getenv("NINFER_SOURCE_REPLAY_ARTIFACT");if (!model || !*model) return 77;
+    require(argc==3,"usage: source_replay_real write|replay|deny|r-pressure work-directory");
+    const std::string mode=argv[1];const std::filesystem::path root=argv[2];
+    const bool mtp=std::getenv("NINFER_SOURCE_REPLAY_MTP")!=nullptr;
+    const bool redundancy=std::getenv("NINFER_SOURCE_REPLAY_REDUNDANCY")!=nullptr;
+    ninfer::EngineOptions o;o.artifact_path=model;o.max_context=65536;
+    o.kv_capacity=ninfer::KvCapacityPolicy::explicit_capacity(2560);o.prefill_chunk=512;
+    o.max_concurrency=1;o.max_pending_requests=4;o.device_profile="off";o.context_cache.enabled=false;
+    o.kv_cache=ninfer::KvCacheStorage::RotatedLloyd4KeyInt4Value;
+    auto& m=o.kvmem;m.selected_tokens=2048;m.reserve_tokens=512;m.host_bytes=96ULL<<20;
+    m.checkpoint_bytes=2048ULL<<20;m.source_bytes=16ULL<<20;m.recovery_bytes=1ULL<<20;
+    if (mode=="r-pressure") m.recovery_bytes=160ULL<<10;
+    m.historical_gc_aux_bytes=64ULL<<20;m.retained_sessions=8;
+    m.query_meanq_cosine=m.score_agg_max=true;m.graph_alpha=0;
+    m.historical_gc_lru=!redundancy;m.historical_gc_redundancy=redundancy;m.verify_transfers=true;
+    if (mtp) {o.speculative.backend=ninfer::SpeculativeBackend::Mtp;o.speculative.draft_tokens=4;}
+    ninfer::Engine engine(o);const auto token=engine.tokenize_text(" Memory").front();
+    auto reference=engine.prepare_tokens({token});
+    ninfer::HistoricalArchiveOptions archive;archive.directory=root/"archive";
+    archive.disk_bytes=64ULL<<20;archive.metadata_bytes=1ULL<<20;archive.create=mode=="write";
+    engine.attach_historical_archive(archive,reference);
+    if (mode=="write") {
+        const auto original=engine.generate(engine.prepare_tokens(std::vector<ninfer::TokenId>(prefix,token)),request());
+        require(original.accepted_source && original.generated_token_ids.size()==8,"writer source incomplete");
+        require(engine.historical_sources().front().retired_native_pages>0,"writer did not retire native pages");
+        std::cerr<<"SOURCE_REPLAY_WRITER_COMPLETE"<<std::endl;
+        auto ticket=engine.begin_historical_save(*original.accepted_source);ticket.wait();engine.finish_historical_save(ticket);
+        const auto k=ticket.key();
+        std::ofstream out(root/"fixture.json");
+        out<<nlohmann::json{{"space",k.space},{"id",k.id},{"ids",original.generated_token_ids}};out.close();require(out.good(),"fixture write failed");
+        require(!mtp || original.speculative.rounds>0,"writer MTP fell back");
+        std::cout<<nlohmann::json{{"status","passed"},{"mode",mode},{"mtp",mtp},{"redundancy",redundancy}}<<std::endl;return 0;
+    }
+    nlohmann::json metadata;{std::ifstream in(root/"fixture.json");in>>metadata;}
+    const ninfer::HistoricalArchiveKey k{metadata.at("space").get<std::array<std::uint8_t,16>>(),metadata.at("id").get<std::uint64_t>()};
+    if (mode=="deny") {
+        rejected(kvmem::MemoryErrorCode::Stale,[&] { (void)engine.import_historical_source(k); });
+        require(engine.historical_archives().empty() && engine.historical_sources().empty(),"forgotten long source revived after restart");
+        require(engine.generate(engine.prepare_tokens(std::vector<ninfer::TokenId>(128,token)),request()).generated_token_ids.size()==8,"reopen denial damaged Engine");
+        std::cout<<nlohmann::json{{"status","passed"},{"mode",mode}}<<std::endl;return 0;
+    }
+    const auto source=engine.import_historical_source(k);
+    auto records=engine.historical_sources();
+    require(records.size()==1 && records.front().computed_tokens==0 && !records.front().parent.id && !records.front().retained_native_domains,
