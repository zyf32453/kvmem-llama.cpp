+void ProgramImpl::progress_historical_gc(SequenceState& sequence) {
+    if (!kvmem_options.historical_gc_lru) return;
+    auto& window = sequence.window;
+    const auto stride = text_host_kv_page_stride + backend_host_kv_page_stride;
+    if (!stride) throw std::logic_error("NInfer historical GC has no native Host page layout");
