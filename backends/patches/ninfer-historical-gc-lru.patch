+        const auto slots = static_cast<std::uint32_t>(std::min<std::uint64_t>(
+            logical_pages, memory_retained_budget / stride));
+        if (slots < 4) throw std::logic_error("NInfer historical GC needs at least four Host pages");
+        const auto high = std::min<uint32_t>(slots, std::max<uint32_t>(2, slots / 16));
+        const auto low = std::max<uint32_t>(1, high / 2);
+        kvmem::HistoricalKvPageGc::Config config;
+        config.slots = slots;
+        config.logical_pages = logical_pages;
+        config.page_tokens = page_tokens;
+        config.sink_tokens = uint64_t(kvmem_options.sink_blocks()) * page_tokens;
+        config.recent_tokens = uint64_t(kvmem_options.recent_blocks()) * page_tokens;
+        config.low_ready = low;
+        config.high_ready = high;
+        window.historical_gc = std::make_unique<kvmem::HistoricalKvPageGc>(config);
+        window.historical_gc->start();
+    }
+    auto& gc = *window.historical_gc;
+    const auto count = static_cast<std::uint32_t>(window.archive.size());
+    if (window.retired_pages.size() < count) window.retired_pages.resize(count);
+    if (window.gc_protected.size() < count) window.gc_protected.resize(count);
+    std::fill(window.gc_protected.begin(), window.gc_protected.end(), 0);
+    const auto protect = [&](std::uint32_t id) {
+        if (id < count) window.gc_protected[id] = 1;
+    };
+    for (std::uint32_t id = 0; id < std::min(count, kvmem_options.sink_blocks()); ++id) protect(id);
+    // The archive can contain preallocated lookahead pages. Recent protection
+    // follows the accepted KV frontier, not the last allocated archive slot.
+    const auto valid_pages = std::min(count, kv_pages_for_tokens(sequence.text_kv_valid));
+    const auto recent = std::min(valid_pages, kvmem_options.recent_blocks());
+    for (std::uint32_t id = valid_pages - recent; id < valid_pages; ++id) protect(id);
+    for (const auto id : window.media_pages) protect(id);
+    for (const auto id : window.pages) protect(id);
+    for (const auto id : window.query_selected) protect(id);
+    for (const auto id : window.query_required) protect(id);
+    for (const auto kind : checkpoint_kinds(window)) {
