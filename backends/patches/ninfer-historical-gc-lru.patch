+    }
+    for (std::uint32_t id = 0; id < count; ++id) {
+        if (!memory_page_selectable(window, id)) continue;
+        if (id < window.host_versions.size() && window.host_versions[id] == page_tokens &&
+            window.archive[id] && !window.archive[id].mutable_resident() && !gc.contains(id)) {
+            if (!gc.register_page(id, window.archive[id].size(), uint64_t(id) + 1))
+                throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,
+                    "NInfer historical GC cannot register a sealed Host page");
+        }
+        if (gc.contains(id)) gc.protect_page(id, window.gc_protected[id] != 0);
