+}
+void descriptor(Reader& in,const kvmem::MemoryDescriptor& d){
+    for(const auto* text:{&d.identity.backend,&d.identity.revision,&d.identity.model,&d.identity.state_schema})
+        check(in.text(4096)==*text,"checkpoint backend/model/state identity mismatch");
+    check(in.text(4096)==d.layout.format,"checkpoint native representation mismatch");
+    in.expect(d.layout.version);in.expect(d.layout.block_tokens);in.expect(d.layout.record_bytes);in.expect(d.layout.alignment);
