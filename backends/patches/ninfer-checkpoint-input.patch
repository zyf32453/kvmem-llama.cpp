+}
+void feedback(Reader& in,std::uint64_t maximum){
+    const auto pages=(maximum+63)/64;std::uint64_t pending=0;
+    for(unsigned list=0;list<3;++list){
+        const auto count=in.count(pages);std::uint64_t previous=0;
+        for(std::uint64_t i=0;i<count;++i){
+            const auto page=in.scalar<std::uint64_t>();
+            check(page%64==0 && page<maximum && (!i || page>previous),"invalid checkpoint feedback key");previous=page;
+            const auto mass=in.scalar<double>();check(std::isfinite(mass) && mass>=0,"invalid checkpoint feedback mass");
+            if(list==2){const auto exposure=in.scalar<double>();check(std::isfinite(exposure) && exposure>=0,"invalid checkpoint feedback exposure");}
+        }
+        if(list==1)pending=count;
+    }
+    const auto samples=in.scalar<std::uint64_t>(),prefill_end=in.scalar<std::uint64_t>();
+    check((samples || !pending) && prefill_end<=maximum,"invalid checkpoint feedback frontier");
+}
