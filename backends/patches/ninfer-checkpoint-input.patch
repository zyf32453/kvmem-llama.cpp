+std::uint64_t multiply(std::uint64_t a,std::uint64_t b){check(!a || b<=UINT64_MAX/a,"checkpoint byte product overflow");return a*b;}
+struct Reader {
+    std::span<const std::uint8_t> bytes;std::size_t position=0;
+    std::span<const std::uint8_t> take(std::uint64_t count){
