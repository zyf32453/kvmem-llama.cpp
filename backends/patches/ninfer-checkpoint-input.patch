+template<class T>void finite(KvmemCheckpointArray<T> values){
+    for(std::size_t i=0;i<values.size();++i)check(std::isfinite(values[i]),"nonfinite checkpoint statistic");
+}
+template<class T>void unique(KvmemCheckpointArray<T> values,std::uint64_t maximum){
+    for(std::size_t i=0;i<values.size();++i){
+        check(values[i]<maximum,"checkpoint logical page out of range");
