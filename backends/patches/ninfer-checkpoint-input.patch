+    std::uint64_t count(std::uint64_t maximum){const auto n=scalar<std::uint64_t>();check(n<=maximum,"native checkpoint count exceeds model bound");return n;}
+    template<class T>KvmemCheckpointArray<T> array(std::uint64_t maximum){return {take(multiply(count(maximum),sizeof(T)))};}
+    std::string_view text(std::uint64_t maximum){auto data=take(count(maximum));return {reinterpret_cast<const char*>(data.data()),data.size()};}
