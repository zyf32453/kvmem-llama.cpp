+    }
+}
+kvmem::SourceRef source_ref(Reader& in){return {{in.scalar<std::uint64_t>(),in.scalar<std::uint64_t>()},in.scalar<std::uint64_t>()};}
+kvmem::MemoryStamp stamp(Reader& in,std::uint64_t maximum){
+    kvmem::MemoryStamp s;s.valid=in.flag();s.session={in.scalar<std::uint64_t>(),in.scalar<std::uint64_t>()};
+    s.history_revision=in.scalar<std::uint64_t>();s.view_version=in.scalar<std::uint64_t>();
+    s.frontier=in.scalar<std::uint64_t>();s.execution_history=in.scalar<std::uint64_t>();
