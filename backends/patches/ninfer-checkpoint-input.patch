+        in.expect(plane.alignment);in.expect(plane.token_stride);
+    }
+}
+void messages(Reader& in,std::uint64_t capacity){
+    if(!in.flag())return;
+    for(auto n=in.count(add(capacity,1));n;--n){
+        const auto begin=in.scalar<std::uint64_t>(),end=in.scalar<std::uint64_t>();const auto known=in.flag();
+        // Old checkpoint graph boundaries can include a discarded suffix;
+        // restore_memory_prefix rebinds them to the current request. Open output
+        // ends also use capacity. These bounds are provenance, not source rights.
+        check(begin<=capacity && end<=capacity && (!known || begin<=end),"invalid checkpoint message span");
+    }
+}
+std::uint64_t graph(Reader& in,std::uint64_t maximum,std::uint64_t capacity){
+    const auto accepted=in.scalar<std::uint64_t>(),completed=in.scalar<std::uint64_t>();
+    in.take(16);in.expect(std::uint32_t(64));
+    check(accepted<=maximum && completed==accepted/64*64,"invalid checkpoint graph frontier");
+    const auto pages=(accepted+63)/64;std::uint64_t previous=0,rows=0;bool first=true;
+    const auto edges=[&](std::uint64_t source,std::uint64_t limit,bool ordered){
+        const auto n=in.count(limit);std::uint64_t last=0;
+        std::array<std::uint64_t,4> seen{};
+        for(std::uint64_t j=0;j<n;++j){
+            const auto target=in.scalar<std::uint64_t>();const auto mass=in.scalar<double>();
+            check(target%64==0 && target<accepted && target<=source && std::isfinite(mass) && mass>=0,"invalid checkpoint graph edge");
+            if(ordered){check(!j || target>last,"unordered checkpoint graph partial");last=target;}
+            else {for(std::uint64_t k=0;k<j;++k)check(seen[k]!=target,"duplicate checkpoint graph edge");seen[j]=target;}
+        }
+        return n;
+    };
+    for(auto n=in.count(pages);n;--n){
+        check(in.flag(),"null checkpoint graph chunk");
+        const auto count=in.count(std::min<std::uint64_t>(256,pages-rows));check(count,"empty checkpoint graph chunk");
