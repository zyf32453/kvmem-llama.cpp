+        auto result=bytes.subspan(position,static_cast<std::size_t>(count));position+=count;return result;
+    }
+    template<class T>T scalar(){T result;auto data=take(sizeof(T));std::memcpy(&result,data.data(),sizeof(T));return result;}
+    template<class T>void expect(T expected){check(scalar<T>()==expected,"incompatible native checkpoint field");}
