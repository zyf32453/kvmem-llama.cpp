+CheckpointPage checkpoint_page(const KvmemWindowState& window, const KvmemPrefixCheckpoint& checkpoint,
+                               std::uint32_t page, std::uint32_t frontier, std::uint32_t recent_blocks) {
+    const auto pages = kv_pages_for_tokens(frontier);
+    if (page >= pages || page >= window.archive.size() || page >= window.host_versions.size())
+        return CheckpointPage::Missing;
+    if (memory_page_selectable(window, page))
+        return window.archive[page] && window.host_versions[page] >= valid_columns(page, frontier)
+            ? CheckpointPage::Available : CheckpointPage::Missing;
+    if (page < window.retired_witnesses.size() && checkpoint_can_omit(window, checkpoint, page,
+            window.retired_witnesses[page], frontier, recent_blocks)) return CheckpointPage::Omit;
+    return CheckpointPage::Missing;
+}
+
+struct HotCheckpointGuard {
+    const KvmemWindowState& window;
+    const KvmemPrefixCheckpoint* checkpoint;
+    std::uint32_t recent_blocks;
+    std::uint32_t vetoed = 0;
+
+    static bool permits(void* context, std::uint32_t page,
+                        kvmem::HistoricalKvStepEvidence::RetainedWitness witness) noexcept {
+        auto& guard = *static_cast<HotCheckpointGuard*>(context);
+        const auto& saved = *guard.checkpoint;
