+std::vector<std::uint32_t> trim_query_window(KvmemWindowState& window, std::uint32_t frontier,
+                                            std::uint32_t budget) {
+    const auto pages = kv_pages_for_tokens(frontier);
+    std::vector<std::uint8_t> witnesses(pages);
+    if (window.historical_evidence) window.historical_evidence->mark_result_pages(witnesses, witness_pin);
+    for (const auto& witness : window.retired_witnesses) {
+        if (!witness.result_end || witness.result_end > frontier) continue;
+        const auto end = std::min<std::uint64_t>(pages, std::uint64_t(witness.page) + witness.page_count);
+        for (auto id = witness.page; id < end; ++id) witnesses[id] = witness_pin;
+    }
+    std::vector<kvmem::QueryTrimPage> optional;
+    optional.reserve(window.query_selected.size());
+    for (const auto id : window.query_selected) {
+        if (witnesses[id] || !window.statistics->has_block(id) ||
+            std::binary_search(window.query_required.begin(), window.query_required.end(), id)) continue;
+        const bool cold = !std::binary_search(window.pages.begin(), window.pages.end(), id);
+        optional.push_back({id, window.selector->selection_score(id), cold});
+    }
+    const auto skipped = kvmem::low_scoring_cold_pages(std::move(optional), budget / 8);
+    auto& selected = window.query_selected;
+    selected.erase(std::remove_if(selected.begin(), selected.end(), [&](std::uint32_t id) {
+        return std::binary_search(skipped.begin(), skipped.end(), id);
+    }), selected.end());
+    return skipped;
+}
