+#pragma once
+#include "models/qwen3_5/program/storage/checkpoint_input.h"
+#include "kvmem/graph_recall.hpp"
+#include "kvmem/historical_kv_page_features.hpp"
+#include "kvmem/kvmem_store.hpp"
+
+namespace ninfer::models::qwen3_5::detail {
+// Owned logical data, movable into native continuation objects. Neither this
+// type nor its records carry a current SourceRef/MemoryStamp or execution lease.
+// The surrounding private read keeps C charged until these objects are gone.
+struct KvmemCheckpointRecordState {
+    std::vector<std::int32_t> prefix;
+    std::vector<std::uint8_t> token_types;
+    std::array<std::vector<std::int32_t>,3> positions;
+    std::vector<std::uint32_t> rewrite_frontiers;
+    std::vector<std::uint64_t> resident_pages;
+    std::vector<float> mean_tail;
+    kvmem::LrfuState history;
+    kvmem::GraphSnapshot graph;
+    kvmem::AttentionFeedbackSnapshot feedback;
+    kvmem::OutputSampleState attention_scope;
+    std::uint64_t image=0;
+};
+struct KvmemCheckpointLogicalState {
+    std::uint64_t admitted_metadata_bytes=0;
+    std::unique_ptr<kvmem::RawKvStore> statistics;
+    std::unique_ptr<kvmem::KvMemStore> selector;
+    std::vector<std::vector<float>> query_rows;
+    kvmem::GraphSnapshot graph;
+    kvmem::AttentionFeedback feedback;
+    kvmem::OutputSampleState attention_scope;
+    std::uint32_t output_begin=0,query_begin=0,query_end=0;
+    std::shared_ptr<const std::vector<kvmem::GraphMessageSpan>> request_messages;
+    std::int32_t think_open=-1,think_close=-1;
+    kvmem::CheckpointCapturePlan capture_plan;
+    std::uint32_t reuse_anchor=0,reconstruction_frontier=0,query_probe_swaps=0;
+    bool query_replayed=false,query_capture=false,query_replay_active=false;
+    std::vector<std::uint32_t> query_selected,query_required;
+    std::shared_ptr<kvmem::HistoricalKvPageFeatures> features;
+    std::shared_ptr<kvmem::HistoricalKvThinkingRanges> thinking;
+    std::vector<KvmemCheckpointRecordState> records;
+};
+
+// Input is the immutable, validated manifest from read_kvmem_checkpoint_metadata.
+// The allocation-free sizing pass covers owned logical storage and temporary
+// shared-control objects. Features/ranges use the existing real M allocator.
+std::uint64_t kvmem_checkpoint_state_metadata_bytes(const KvmemCheckpointManifest&,
+    const KvmemCheckpointInputLimits&,const kvmem::KvMemStoreConfig&);
+std::unique_ptr<KvmemCheckpointLogicalState> prepare_kvmem_checkpoint_state(
+    const KvmemCheckpointManifest&,const KvmemCheckpointInputLimits&,
+    const kvmem::KvMemStoreConfig&,std::shared_ptr<kvmem::HistoricalKvAuxBudget>,
+    const std::function<void(std::uint64_t)>& admit_metadata);
+} // namespace ninfer::models::qwen3_5::detail
