+            state->metadata_charge.resize(add(add(control,state->metadata.capacity()),logical));
             // Admit the COMPLETE unpublished image set and H payload first.
             // This control path is serialized; no other Program allocation can
             // consume C between this check and individual pool acquisition.
@@ -335,6 +347,9 @@ std::unique_ptr<KvmemCheckpointRead> ProgramImpl::read_historical_checkpoint(His
     state->manifest=input.finish(state->checkpoint->payload_bytes());
     source_archive->validate(*state->checkpoint);
     for(auto& page:state->pages)if(page)page.seal();
