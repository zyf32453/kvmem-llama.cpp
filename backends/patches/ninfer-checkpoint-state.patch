diff --git a/src/models/qwen3_5/program/storage/checkpoint_state.cpp b/src/models/qwen3_5/program/storage/checkpoint_state.cpp
new file mode 100644
index 0000000..63fcff0
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/checkpoint_state.cpp
@@ -0,0 +1,161 @@
+#include "models/qwen3_5/program/storage/checkpoint_state.h"
+#include <algorithm>
+#include <limits>
+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+void check(bool value,const char* message){if(!value)throw kvmem::SnapshotCorrupt(message);}
+std::uint64_t add(std::uint64_t a,std::uint64_t b){
+    if(b>SIZE_MAX-a)throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint logical metadata overflow");
+    return a+b;
+}
+std::uint64_t product(std::uint64_t a,std::uint64_t b){
+    if(b && a>SIZE_MAX/b)throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint logical array overflow");
+    return a*b;
+}
+struct Cursor {
+    std::span<const std::uint8_t> data;std::size_t offset=0;
+    void take(void* destination,std::size_t bytes){
+        check(bytes<=data.size()-offset,"truncated checkpoint logical metadata");
+        if(destination && bytes)std::memcpy(destination,data.data()+offset,bytes);offset+=bytes;
+    }
+    template<class T>T scalar(){T value;take(&value,sizeof(value));return value;}
+    bool flag(){const auto value=scalar<std::uint8_t>();check(value<2,"invalid checkpoint logical flag");return value!=0;}
+    std::size_t count(std::size_t maximum){const auto n=scalar<std::uint64_t>();
+        check(n<=maximum && n<=SIZE_MAX,"checkpoint logical count out of range");return std::size_t(n);}
+    template<class T>std::size_t array_size(){const auto n=count(SIZE_MAX/sizeof(T));take(nullptr,n*sizeof(T));return n;}
+    void done()const{check(offset==data.size(),"extra checkpoint logical metadata");}
+    kvmem::SnapshotReader reader(){return {[this](void* p,std::size_t n){take(p,n);},data.size()-offset};}
+};
+constexpr std::uint64_t control=64; // bounded shared_ptr control on the supported 64-bit toolchains
+std::uint64_t lrfu_bytes(Cursor& in){
+    in.take(nullptr,9);return add(4*(control+sizeof(std::vector<double>)),product(in.array_size<double>(),sizeof(double)));
+}
+std::uint64_t messages_bytes(Cursor& in){
+    if(!in.flag())return 0;const auto n=in.count(SIZE_MAX/17);in.take(nullptr,n*17);
+    return add(control+sizeof(std::vector<kvmem::GraphMessageSpan>),product(n,sizeof(kvmem::GraphMessageSpan)));
+}
+std::uint64_t edges_bytes(Cursor& in){const auto n=in.count(SIZE_MAX/16);in.take(nullptr,n*16);return product(n,sizeof(kvmem::GraphEdge));}
+std::uint64_t graph_bytes(Cursor& in){
+    in.take(nullptr,4*8+4);const auto n=in.count(SIZE_MAX/sizeof(std::shared_ptr<const std::vector<kvmem::GraphRow>>));
+    std::uint64_t bytes=product(n,sizeof(std::shared_ptr<const std::vector<kvmem::GraphRow>>));
+    for(std::size_t i=0;i<n;++i){check(in.flag(),"null checkpoint graph chunk");const auto rows=in.count(256);
+        bytes=add(bytes,add(control+sizeof(std::vector<kvmem::GraphRow>),product(rows,sizeof(kvmem::GraphRow))));
+        for(std::size_t row=0;row<rows;++row){in.take(nullptr,16);bytes=add(bytes,edges_bytes(in));}}
+    in.take(nullptr,16);bytes=add(bytes,edges_bytes(in));return add(bytes,messages_bytes(in));
+}
+std::uint64_t feedback_bytes(Cursor& in){
+    std::uint64_t bytes=0;for(unsigned i=0;i<3;++i){const auto n=in.count(SIZE_MAX/24);in.take(nullptr,n*(i==2 ? 24 : 16));
+        bytes=add(bytes,product(n,i==2 ? sizeof(std::pair<std::uint64_t,kvmem::PrefillMass>) : sizeof(std::pair<std::uint64_t,double>)));}
+    in.take(nullptr,16);return bytes;
+}
+template<class T>std::vector<T> copy(KvmemCheckpointArray<T> source){
+    std::vector<T> result(source.size());if(!source.bytes.empty())std::memcpy(result.data(),source.bytes.data(),source.bytes.size());return result;
+}
+std::vector<kvmem::GraphEdge> edges(Cursor& in){
+    std::vector<kvmem::GraphEdge> result(in.count(SIZE_MAX/sizeof(kvmem::GraphEdge)));
+    for(auto& edge:result){edge.target=in.scalar<std::uint64_t>();edge.mass=in.scalar<double>();}return result;
+}
+std::shared_ptr<const std::vector<kvmem::GraphMessageSpan>> messages(Cursor& in){
+    if(!in.flag())return {};auto result=std::make_shared<std::vector<kvmem::GraphMessageSpan>>(in.count(SIZE_MAX/sizeof(kvmem::GraphMessageSpan)));
+    for(auto& span:*result){span.begin=in.scalar<std::uint64_t>();span.end=in.scalar<std::uint64_t>();span.end_known=in.flag();}return result;
+}
+kvmem::GraphSnapshot graph(std::span<const std::uint8_t> bytes){
+    Cursor in{bytes};kvmem::GraphSnapshot g;
+    g.accepted_through=in.scalar<std::uint64_t>();g.completed_through=in.scalar<std::uint64_t>();
+    g.revision=in.scalar<std::uint64_t>();g.epoch=in.scalar<std::uint64_t>();g.block_tokens=in.scalar<std::uint32_t>();
+    g.chunks.resize(in.count(SIZE_MAX/sizeof(g.chunks[0])));
+    for(auto& chunk:g.chunks){check(in.flag(),"null checkpoint graph chunk");
+        auto rows=std::make_shared<std::vector<kvmem::GraphRow>>(in.count(256));
+        for(auto& row:*rows){row.source=in.scalar<std::uint64_t>();row.samples=in.scalar<std::uint64_t>();row.edges=edges(in);}chunk=std::move(rows);}
+    g.partial.source=in.scalar<std::uint64_t>();g.partial.samples=in.scalar<std::uint64_t>();g.partial.mass=edges(in);g.messages=messages(in);in.done();return g;
+}
+kvmem::AttentionFeedbackSnapshot feedback(std::span<const std::uint8_t> bytes){
+    Cursor in{bytes};kvmem::AttentionFeedbackSnapshot result;
+    for(auto* list:{&result.output,&result.pending_output}){list->resize(in.count(SIZE_MAX/sizeof((*list)[0])));
+        for(auto& [page,mass]:*list){page=in.scalar<std::uint64_t>();mass=in.scalar<double>();}}
+    result.prefill.resize(in.count(SIZE_MAX/sizeof(result.prefill[0])));
+    for(auto& [page,mass]:result.prefill){page=in.scalar<std::uint64_t>();mass.mass=in.scalar<double>();mass.exposure=in.scalar<double>();}
+    result.output_samples=in.scalar<std::uint64_t>();result.prefill_end=in.scalar<std::uint64_t>();in.done();return result;
+}
+kvmem::OutputSampleState scope(std::span<const std::uint8_t> bytes){Cursor in{bytes};
+    kvmem::OutputSampleState result{in.flag(),in.scalar<std::uint64_t>()};in.done();return result;}
+kvmem::LrfuState lrfu(std::span<const std::uint8_t> bytes,std::uint32_t pages){Cursor in{bytes};auto reader=in.reader();
+    auto result=kvmem::read_lrfu(reader,pages);in.done();return result;}
+template<class T>std::vector<T> array(Cursor& in){auto reader=in.reader();return reader.vector<T>(SIZE_MAX/sizeof(T));}
+void require_config(const KvmemCheckpointManifest& m,const KvmemCheckpointInputLimits& l,const kvmem::KvMemStoreConfig& cfg){
+    if(!l.maximum_tokens || !m.record_count || m.record_count>kKvmemCheckpointMaximumRecords ||
+        cfg.block_tokens!=64 || cfg.select_budget!=l.selected_tokens || !l.statistics.payload_storage)
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::InvalidPlan,"checkpoint logical state requires current selector and payload accounts");
+}
+} // namespace
+
+std::uint64_t kvmem_checkpoint_state_metadata_bytes(const KvmemCheckpointManifest& m,const KvmemCheckpointInputLimits& l,
+                                                   const kvmem::KvMemStoreConfig& cfg){
+    require_config(m,l,cfg);std::uint64_t bytes=sizeof(KvmemCheckpointLogicalState);
+    Cursor stats{m.statistics};stats.take(nullptr,44);const auto blocks=stats.count((std::uint64_t(l.maximum_tokens)+63)/64+1);
+    try{bytes=add(bytes,kvmem::RawKvStore::mean_snapshot_capacity_bytes(l.statistics,std::uint32_t(blocks)));}
+    catch(const std::overflow_error&){throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint mean statistics exceed C");}
+    Cursor selector{m.selector};selector.take(nullptr,8);const auto count=selector.count((std::uint64_t(l.maximum_tokens)+63)/64);
+    selector.take(nullptr,product(count,36));bytes=add(bytes,add(sizeof(kvmem::KvMemStore)+2*(cfg.numa_policy.capacity()+1),product(count,sizeof(kvmem::KvMemBlock))));
+    bytes=add(bytes,lrfu_bytes(selector));selector.done();
+    bytes=add(bytes,product(l.query_layers,sizeof(std::vector<float>)));
+    Cursor g{m.graph},f{m.feedback},request{m.request},planning{m.planning};
+    bytes=add(bytes,graph_bytes(g));g.done();bytes=add(bytes,feedback_bytes(f));f.done();
+    request.take(nullptr,4);bytes=add(bytes,messages_bytes(request));
+    planning.take(nullptr,49+4*8+2+2*4+3+4);
+    bytes=add(bytes,product(planning.array_size<std::uint32_t>(),sizeof(std::uint32_t)));
+    bytes=add(bytes,product(planning.array_size<std::uint32_t>(),sizeof(std::uint32_t)));planning.done();
+    if(!m.features.empty())bytes=add(bytes,sizeof(kvmem::HistoricalKvPageFeatures)+control);
+    if(!m.thinking.empty())bytes=add(bytes,sizeof(kvmem::HistoricalKvThinkingRanges)+control);
+    bytes=add(bytes,product(m.record_count,sizeof(KvmemCheckpointRecordState)));
+    for(std::size_t i=0;i<m.record_count;++i){const auto& record=m.records[i];
+        bytes=add(bytes,record.prefix.bytes.size());bytes=add(bytes,record.token_types.bytes.size());
+        for(const auto& axis:record.positions)bytes=add(bytes,axis.bytes.size());
+        bytes=add(bytes,record.rewrite_frontiers.bytes.size());bytes=add(bytes,record.resident_pages.bytes.size());bytes=add(bytes,record.mean_tail.bytes.size());
+        Cursor history{record.history},graph{record.graph},feedback{record.feedback};
+        bytes=add(bytes,lrfu_bytes(history));history.done();bytes=add(bytes,graph_bytes(graph));graph.done();
+        bytes=add(bytes,feedback_bytes(feedback));feedback.done();
+    }
+    return bytes;
+}
+
+std::unique_ptr<KvmemCheckpointLogicalState> prepare_kvmem_checkpoint_state(const KvmemCheckpointManifest& m,
+    const KvmemCheckpointInputLimits& l,const kvmem::KvMemStoreConfig& cfg,
+    std::shared_ptr<kvmem::HistoricalKvAuxBudget> auxiliary,const std::function<void(std::uint64_t)>& admit){
+    if(!admit || ((!m.features.empty() || !m.thinking.empty()) && !auxiliary))
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::InvalidPlan,"checkpoint logical state requires C admission and real M");
+    const auto bytes=kvmem_checkpoint_state_metadata_bytes(m,l,cfg);admit(bytes);
+    auto state=std::make_unique<KvmemCheckpointLogicalState>();state->admitted_metadata_bytes=bytes;
+    const auto pages=std::uint32_t((std::uint64_t(l.maximum_tokens)+63)/64);
+    state->statistics=std::make_unique<kvmem::RawKvStore>(l.statistics);
+    Cursor statistics{m.statistics};auto statistic_reader=statistics.reader();state->statistics->snapshot_read(statistic_reader,pages);statistics.done();
+    Cursor selector{m.selector};const auto total=selector.scalar<std::uint32_t>(),runtime=selector.scalar<std::uint32_t>();
+    std::vector<kvmem::KvMemBlock> blocks(selector.count(pages));
+    for(auto& block:blocks){block.block_id=selector.scalar<std::uint32_t>();block.orig_pos_start=selector.scalar<std::uint32_t>();
+        block.n_tokens=selector.scalar<std::uint32_t>();block.attn_score=selector.scalar<double>();block.profile_score=selector.scalar<double>();block.retrieval_score=selector.scalar<double>();}
+    auto history_reader=selector.reader();auto history=kvmem::read_lrfu(history_reader,pages);selector.done();
+    state->selector=std::make_unique<kvmem::KvMemStore>(cfg);state->selector->restore_checkpoint_statistics(total,runtime,std::move(blocks),history);
+    state->query_rows.resize(l.query_layers);state->graph=graph(m.graph);state->feedback.restore(feedback(m.feedback));state->attention_scope=scope(m.scope);
+    Cursor request{m.request};state->output_begin=request.scalar<std::uint32_t>();state->request_messages=messages(request);
+    state->think_open=request.scalar<std::int32_t>();state->think_close=request.scalar<std::int32_t>();
+    check(!request.scalar<std::uint32_t>(),"retained checkpoint has live query samples");
+    state->query_begin=request.scalar<std::uint32_t>();state->query_end=request.scalar<std::uint32_t>();request.done();
+    Cursor planning{m.planning};planning.take(nullptr,49);
+    state->capture_plan.next=planning.scalar<std::uint64_t>();state->capture_plan.interval=planning.scalar<std::uint64_t>();
+    state->capture_plan.root=planning.scalar<std::uint64_t>();state->capture_plan.tail=planning.scalar<std::uint64_t>();
+    state->capture_plan.root_done=planning.flag();state->capture_plan.tail_done=planning.flag();
+    state->reuse_anchor=planning.scalar<std::uint32_t>();state->reconstruction_frontier=planning.scalar<std::uint32_t>();
+    state->query_replayed=planning.flag();state->query_capture=planning.flag();state->query_replay_active=planning.flag();
+    state->query_probe_swaps=planning.scalar<std::uint32_t>();state->query_selected=array<std::uint32_t>(planning);state->query_required=array<std::uint32_t>(planning);planning.done();
+    if(!m.features.empty()){Cursor in{m.features};auto reader=in.reader();state->features=kvmem::HistoricalKvPageFeatures::snapshot_read(reader,pages,l.feature_dimensions,auxiliary);in.done();}
+    if(!m.thinking.empty()){Cursor in{m.thinking};auto reader=in.reader();state->thinking=kvmem::HistoricalKvThinkingRanges::snapshot_read(reader,m.origin.accepted_frontier,auxiliary);in.done();}
+    state->records.resize(m.record_count);
+    for(std::size_t i=0;i<m.record_count;++i){const auto& view=m.records[i];auto& record=state->records[i];
+        record.prefix=copy(view.prefix);record.token_types=copy(view.token_types);for(unsigned axis=0;axis<3;++axis)record.positions[axis]=copy(view.positions[axis]);
+        record.rewrite_frontiers=copy(view.rewrite_frontiers);record.resident_pages=copy(view.resident_pages);record.mean_tail=copy(view.mean_tail);
+        record.history=lrfu(view.history,pages);record.graph=graph(view.graph);record.feedback=feedback(view.feedback);record.attention_scope=scope(view.scope);record.image=view.image;
+    }
+    return state;
+}
+} // namespace ninfer::models::qwen3_5::detail
