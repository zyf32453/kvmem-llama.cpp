+void ProgramImpl::capture_memory_control_anchor(SequenceState& sequence) noexcept {
+    if (!kvmem_window_tokens || !requests[sequence.lane].allow_memory_reuse) return;
+    auto& window=sequence.window;
+    // A separately encoded thinking-control span can merge whitespace with the
+    // pending generated token when the next request is tokenized. Keep the last
+    // complete State/KV frontier BEFORE that pending token. Exact identity is
+    // still required at restore; never normalize or rewrite a live token ledger.
+    const auto* anchor=memory_checkpoint(window,KvmemCheckpointKind::ReuseAnchor);
+    if (anchor && anchor->prefix.size()>=window.output_begin) return;
+    try {
+        const auto started=Clock::now();
+        auto captured=capture_memory_checkpoint(sequence,true);
+        memory_checkpoint_slot(window,KvmemCheckpointKind::ReuseAnchor)=std::move(captured);
+        window.checkpoints.prune();
+        if (kvmem_options.verify_transfers || prefix_audit_enabled())
+            std::fprintf(stderr,"KVMEM_CONTROL_ANCHOR frontier=%u capture_ms=%.3f\n",sequence.text_kv_valid,
+                std::chrono::duration<double,std::milli>(Clock::now()-started).count());
+    } catch (const std::exception& error) {
+        std::fprintf(stderr,"KVMEM_CONTROL_ANCHOR capture skipped: %s\n",error.what());
+    }
+}
