+    options.execution.allow_prefix_reuse = reuse;
+    options.execution.sampling.temperature = 0.0F;
+    options.execution.sampling.seed = 42;
+    options.execution.thinking.loop = ninfer::ReasoningLoopAction::Off;
+    options.stop.include_model_defaults = false;
+    options.output.raw = options.output.preserve_special_tokens = true;
+    return options;
+}
+struct CancelDuringPrefill final : ninfer::OutputSink {
+    std::atomic<bool> cancel{false};
+    std::uint32_t processed = 0;
+    void start(ninfer::GenerationStart start) override { require(start.reused_prompt_tokens == 0, "recovery silently reused old KV"); }
+    void progress(ninfer::PromptProgress progress) override {
+        if (progress.processed_prompt_tokens && progress.processed_prompt_tokens < progress.total_prompt_tokens) {
+            processed = progress.processed_prompt_tokens;
+            cancel.store(true, std::memory_order_release);
+        }
+    }
+    void timing(ninfer::GenerationTimingObservation) override {}
+    void publish(ninfer::OutputDelta) override {}
+};
+int run() {
+    const char* artifact = std::getenv("NINFER_SOURCE_RECOVERY_ARTIFACT");
+    if (!artifact || !*artifact) return 77;
+    const bool mtp = std::getenv("NINFER_SOURCE_RECOVERY_MTP") != nullptr;
+    const bool redundancy = std::getenv("NINFER_SOURCE_RECOVERY_REDUNDANCY") != nullptr;
+    ninfer::EngineOptions options;
+    options.artifact_path = artifact;
+    options.max_context = 65536;
+    options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(2560);
+    options.prefill_chunk = 512;
+    options.max_concurrency = 1;
+    options.max_pending_requests = 4;
+    options.device_profile = "off";
+    options.context_cache.enabled = false;
+    options.kv_cache = ninfer::KvCacheStorage::RotatedLloyd4KeyInt4Value;
+    options.kvmem.selected_tokens = 2048;
+    options.kvmem.reserve_tokens = 512;
+    options.kvmem.host_bytes = 96ULL << 20;
+    options.kvmem.source_bytes = 16ULL << 20;
+    options.kvmem.recovery_bytes = 8192;
+    options.kvmem.query_meanq_cosine = options.kvmem.score_agg_max = true;
+    options.kvmem.graph_alpha = 0;
+    options.kvmem.historical_gc_lru = !redundancy;
+    options.kvmem.historical_gc_redundancy = redundancy;
+    options.kvmem.verify_transfers = true;
+    if (mtp) { options.speculative.backend = ninfer::SpeculativeBackend::Mtp; options.speculative.draft_tokens = 4; }
+    ninfer::Engine engine(options);
+    const auto encoded = engine.tokenize_text(" Memory");
+    require(!encoded.empty(), "test token encoding failed");
+    std::vector<ninfer::TokenId> long_input(32768, encoded.front());
+    const auto original = engine.generate(engine.prepare_tokens(long_input), request(8));
+    require(original.generated_token_ids.size() == 8, "long source did not finish");
+    require(!mtp || original.speculative.rounds > 0, "configured MTP executed no speculative round");
+    const auto records = engine.historical_sources();
+    require(records.size() == 1 && records.front().accepted_tokens == long_input.size() + 8, "source input/output missing");
+    require(records.front().retained_native_domains == 1, "initial native history was not retained");
+    require(records.front().retired_native_pages > 0, "no real native retirement occurred");
+    require(original.accepted_source && *original.accepted_source == records.front().ref, "generation did not return its exact source receipt");
+    const auto source = *original.accepted_source;
+    const auto retired_pages = records.front().retired_native_pages;
+    auto stale = source; ++stale.revision;
+    rejected(kvmem::MemoryErrorCode::Stale, [&] { (void)engine.prepare_source_rebuild(stale, 1024, 32); });
+    rejected(kvmem::MemoryErrorCode::BudgetExceeded, [&] { (void)engine.prepare_source_rebuild(source, 4096, 32); });
+    {
+        auto first = engine.prepare_source_rebuild(source, 1024, 32);
+        auto second = engine.prepare_source_rebuild(source, 1024, 32);
+        require(engine.memory_summary().kvmem.recovery_bytes == 8192, "real shared R charge missing");
+        rejected(kvmem::MemoryErrorCode::BudgetExceeded, [&] { (void)engine.prepare_source_rebuild(source, 1024, 32); });
+    }
+    (void)engine.historical_sources();
+    require(engine.memory_summary().kvmem.recovery_bytes == 0, "destroyed preparations did not refund R");
+    const auto retained_before = engine.memory_summary().kvmem.retained_sessions;
+    const auto source_count_before = engine.historical_sources().size();
+    rejected(kvmem::MemoryErrorCode::BudgetExceeded, [&] {
+        (void)engine.generate(engine.prepare_source_rebuild(source, 1024, 32), request(1024));
+    });
+    require(engine.historical_sources().size() == source_count_before, "rejected admission partially published a source branch");
+    require(engine.memory_summary().kvmem.recovery_bytes == 0, "rejected admission retained preparation");
+    CancelDuringPrefill sink;
+    auto cancelled = engine.submit(engine.prepare_source_rebuild(source, 1920, 32), request(32),
+        ninfer::OutputConsumerMode::Streaming, {.prompt_progress = true});
+    const auto cancellation = cancelled.wait(&sink, ninfer::CancellationView([&] { return sink.cancel.load(std::memory_order_acquire); }));
+    require(sink.processed > 0 && cancellation.computed_prompt_tokens < 1920 &&
+            cancellation.finish_reason == ninfer::FinishReason::Cancelled, "actual partial rebuild cancellation not observed");
+    const auto cancelled_sources = engine.historical_sources();
+    require(cancellation.accepted_source.has_value(), "partial accepted input lost its source receipt");
+    require(std::any_of(cancelled_sources.begin(), cancelled_sources.end(), [&](const auto& record) {
+        return record.ref == *cancellation.accepted_source && record.parent == source &&
+               record.parent_prefix_tokens == 1920 && record.accepted_tokens == 1920 &&
+               record.computed_tokens == cancellation.computed_prompt_tokens && !record.retained_native_domains;
+    }), "cancelled source receipt/ancestry/computed frontier differs from its request");
+    require(engine.memory_summary().kvmem.recovery_bytes == 0, "cancelled rebuild retained R");
+    require(engine.memory_summary().kvmem.retained_sessions == retained_before, "incomplete recovery entered retained history");
+
+    std::vector<ninfer::TokenId> prefix(long_input.begin(), long_input.begin() + 1024);
+    auto prepared = engine.prepare_source_rebuild(source, 1024, 32);
+    require(std::equal(prepared.token_ids().begin(), prepared.token_ids().end(), prefix.begin(), prefix.end()), "recovery prepared wrong accepted IDs");
+    const auto rebuilt = engine.generate(std::move(prepared), request(8));
+    require(rebuilt.reused_prompt_tokens == 0 && rebuilt.computed_prompt_tokens == 1024, "rebuild did not execute a fresh complete prefix");
+    (void)engine.historical_sources();
+    require(engine.memory_summary().kvmem.recovery_bytes == 0, "successful rebuild retained R");
+    // Independent request from known original IDs; prefix reuse disabled explicitly.
+    const auto fresh = engine.generate(engine.prepare_tokens(prefix, false), request(8, false));
+    require(rebuilt.generated_token_ids == fresh.generated_token_ids, "greedy canonical rebuild differs from fresh original IDs");
+    require(!mtp || rebuilt.speculative.rounds > 0, "MTP reconstruction was checked only through ordinary fallback");
+    auto stop_request = request(8);
+    stop_request.stop.token_ids = {fresh.generated_token_ids.front()};
+    stop_request.output.raw = false; // Raw mode deliberately publishes the accepted stop token.
+    const auto stopped = engine.generate(engine.prepare_source_rebuild(source, 1024, 32), std::move(stop_request));
+    require(stopped.finish_reason == ninfer::FinishReason::StopToken && stopped.content.empty() && stopped.generated_token_ids.size() == 1, "first-token stop did not exercise terminal rebuild commit");
+    (void)engine.historical_sources();
+    require(engine.memory_summary().kvmem.recovery_bytes == 0, "first-token stop retained R");
+    const auto after = engine.historical_sources();
+    require(rebuilt.accepted_source && rebuilt.accepted_source->id != source.id, "rebuild did not publish a new source receipt");
+    require(std::any_of(after.begin(), after.end(), [&](const auto& record) {
+        return record.ref == *rebuilt.accepted_source && record.parent == source && record.parent_prefix_tokens == 1024;
+    }), "later requests changed the rebuild receipt or lost its ancestry");
+    require(std::any_of(after.begin(), after.end(), [&](const auto& record) {
+        return record.ref.id == source.id && record.ref.incarnation == source.incarnation && record.ref.revision == source.revision && record.retired_native_pages == retired_pages;
+    }), "recovery changed or consumed the original accepted source");
+    // Move the original native history out of the bounded cache, keeping S alive.
+    for (int i = 0; i < 6; ++i) {
+        auto changed = prefix;
+        const auto different = engine.tokenize_text(std::string(1, char('a' + i)));
+        require(!different.empty(), "churn token encoding failed");
+        changed.front() = different.front(); changed.push_back(encoded.front());
+        (void)engine.generate(engine.prepare_tokens(std::move(changed)), request(1));
+    }
+    const auto churned = engine.historical_sources();
+    const auto old = std::find_if(churned.begin(), churned.end(), [&](const auto& record) { return record.ref.id == source.id; });
+    require(old != churned.end() && old->retained_native_domains == 0, "original native window was not actually evicted");
+    const auto without_old_window = engine.generate(engine.prepare_source_rebuild(source, 1024, 32), request(8));
+    require(without_old_window.reused_prompt_tokens == 0 && without_old_window.computed_prompt_tokens == 1024 &&
+            without_old_window.generated_token_ids == fresh.generated_token_ids, "source-only rebuild after cache churn failed");
+    require(!mtp || without_old_window.speculative.rounds > 0, "source-only MTP rebuild ran no speculative round");
+    std::cout << nlohmann::json{{"status", "passed"}, {"mtp", mtp}, {"redundancy", redundancy},
+        {"source_id", source.id}, {"rebuilt_source_id", rebuilt.accepted_source->id},
+        {"cancelled_source_id", cancellation.accepted_source->id}, {"retired_pages", retired_pages}, {"input_tokens", long_input.size()}, {"rebuild_prefix", 1024},
+        {"original_speculative_rounds", original.speculative.rounds}, {"rebuilt_speculative_rounds", rebuilt.speculative.rounds},
+        {"source_only_speculative_rounds", without_old_window.speculative.rounds},
+        {"first_token_stop", stopped.finish_reason == ninfer::FinishReason::StopToken}, {"admission_reserve_rejected", true},
+        {"cancel_processed", sink.processed}, {"cancel_computed", cancellation.computed_prompt_tokens},
+        {"canonical_output_ids", rebuilt.generated_token_ids}, {"fresh_output_ids", fresh.generated_token_ids},
+        {"source_only_output_ids", without_old_window.generated_token_ids},
+        {"final_source_records", engine.historical_sources().size()},
+        {"history_evictions", engine.memory_summary().kvmem.history_evictions}}.dump() << std::endl;
+    return 0;
+}
+}
+int main() {
+    try { return run(); }
+    catch (const std::exception& error) { std::cerr << "SOURCE_RECOVERY_FATAL: " << error.what() << std::endl; return 1; }
+}
