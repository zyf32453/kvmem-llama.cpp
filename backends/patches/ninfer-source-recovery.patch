+std::vector<HistoricalSourceSummary> ProgramImpl::historical_sources() const {
+    std::vector<HistoricalSourceSummary> result;
+    if (!source_journal) return result;
+    result.reserve(source_journal->stats().sources);
+    for (std::size_t slot = 0; slot < source_journal->slots(); ++slot) {
+        if (const auto state = source_journal->inspect(slot)) {
+            HistoricalSourceSummary summary{{state->ref.source.id, state->ref.source.incarnation, state->ref.revision},
+                state->accepted_frontier, state->computed_frontier, state->events};
+            summary.parent = {state->parent.source.id, state->parent.source.incarnation, state->parent.revision};
+            summary.parent_prefix_tokens = state->parent_prefix;
+            for (const auto& history : memory_histories)
+                if (history && history->source.source == state->ref.source) {
+                    ++summary.retained_native_domains;
+                    summary.retired_native_pages += std::count(history->retired_pages.begin(), history->retired_pages.end(), std::uint8_t(1));
+                }
+            result.push_back(summary);
+        }
+    }
+    return result;
+}
