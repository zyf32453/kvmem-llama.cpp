--- a/src/models/qwen3_5/frontend/frontend.cpp
+++ b/src/models/qwen3_5/frontend/frontend.cpp
@@ -1,5 +1,7 @@
 #include "models/qwen3_5/frontend/frontend.h"
 
+#include "core/paged_kv_cache.h"
+#include "kvmem/historical_kv_semantic.hpp"
 #include "models/qwen3_5/frontend/resources.h"
 #include "models/qwen3_5/frontend/digest.h"
 #include "models/qwen3_5/frontend/prepared_prompt.h"
@@ -1545,9 +1547,36 @@ PreparedPrompt Frontend::prepare(PromptInput input, const PreparationControl& co
         }
         if (fi::sha256_hex(fi::sha256(bytes)) != proof.prefix_sha256)
             throw RequestError(RequestErrorKind::InvalidGcEvidence, "GC evidence prefix token digest mismatch");
-        for (const auto& step : proof.steps)
+        result.historical_gc_witness_masks.resize(proof.steps.size());
+        constexpr auto page_tokens = static_cast<std::size_t>(kPagedKVPageSize);
+        const auto first_page = [](std::uint32_t token) {
+            return (std::size_t(token) + page_tokens - 1) / page_tokens;
+        };
+        for (std::size_t index = 0; index < proof.steps.size(); ++index) {
+            const auto& step = proof.steps[index];
             if (step.source_end > proof.prefix_tokens || step.result_end > proof.prefix_tokens)
                 throw RequestError(RequestErrorKind::InvalidGcEvidence, "GC evidence exceeds its verified prefix");
+            if (step.kind != "thinking") continue;
+            const auto source_begin = first_page(step.source_begin);
+            const auto source_end = step.source_end / page_tokens;
+            const auto result_begin = first_page(step.result_begin);
+            const auto result_end = step.result_end / page_tokens;
+            if (source_end <= source_begin || result_end <= result_begin ||
+                source_end - source_begin > kvmem::historical_kv_max_source_pages ||
+                result_end - result_begin > kvmem::historical_kv_max_witness_pages) continue;
+            const std::vector<TokenId> source(result.token_ids.begin() + source_begin * page_tokens,
+                result.token_ids.begin() + source_end * page_tokens);
+            const std::vector<TokenId> witnesses(result.token_ids.begin() + result_begin * page_tokens,
+                result.token_ids.begin() + result_end * page_tokens);
+            std::vector<std::uint8_t> digits;
+            digits.reserve(source.size());
+            for (const auto token : source) {
+                const auto piece = impl_->tokenizer->decode_token_bytes(token, false);
+                digits.push_back(piece.find_first_of("0123456789") != std::string_view::npos);
+            }
+            result.historical_gc_witness_masks[index] =
+                kvmem::historical_kv_literal_witnesses(source, digits, witnesses, page_tokens);
+        }
     }
     result.prepare.seconds = std::chrono::duration<double>(Clock::now() - start).count();
     return PreparedPrompt(std::move(prepared));
