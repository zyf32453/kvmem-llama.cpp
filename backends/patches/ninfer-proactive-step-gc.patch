diff --git a/src/serve/historical_gc_evidence.cpp b/src/serve/historical_gc_evidence.cpp
new file mode 100644
index 0000000..ed90242
--- /dev/null
+++ b/src/serve/historical_gc_evidence.cpp
@@ -0,0 +1,77 @@
+#include "serve/historical_gc_evidence.h"
+#include "serve/request_validation.h"
+#include <algorithm>
+#include <cmath>
+#include <initializer_list>
+
+namespace ninfer::serve {
+namespace {
+using Json = RequestJson;
+void require_object(const Json& value, const char* message, const char* param) {
+    if (!value.is_object()) bad_request(message, param);
+}
+bool get_bool(const Json& object, const char* key, bool fallback) {
+    if (!object.contains(key)) return fallback;
+    if (!object.at(key).is_boolean()) bad_request("GC observation flags must be booleans", "kvmem_gc");
+    return object.at(key).get<bool>();
+}
+} // namespace
+// A development extension: evidence is bound to actual prepared token IDs again
+// in the frontend. Text labels alone never authorize retirement.
+std::optional<HistoricalGcEvidenceBatch> parse_historical_gc_evidence(const Json& body) {
+    if (!body.contains("kvmem_gc")) return std::nullopt;
+    const auto& proof = body.at("kvmem_gc");
+    require_object(proof, "kvmem_gc must be an object", "kvmem_gc");
+    auto fields = [](const Json& value, std::initializer_list<std::string_view> allowed) {
+        for (const auto& item : value.items())
+            if (std::find(allowed.begin(), allowed.end(), item.key()) == allowed.end())
+                bad_request("Unknown kvmem_gc field: " + item.key(), "kvmem_gc");
+    };
+    auto integer = [](const Json& value, const char* key, std::uint64_t maximum) {
+        if (!value.contains(key) || !value.at(key).is_number_integer() ||
+            (!value.at(key).is_number_unsigned() && value.at(key).get<std::int64_t>() < 0))
+            bad_request(std::string("kvmem_gc requires unsigned integer ") + key, "kvmem_gc");
+        const auto number = value.at(key).get<std::uint64_t>();
+        if (number > maximum) bad_request("kvmem_gc integer exceeds its domain", "kvmem_gc");
+        return number;
+    };
+    fields(proof, {"prefix_tokens", "prefix_sha256", "steps"});
+    HistoricalGcEvidenceBatch result;
+    result.prefix_tokens = integer(proof, "prefix_tokens", UINT32_MAX);
+    if (!result.prefix_tokens || !proof.contains("prefix_sha256") || !proof.at("prefix_sha256").is_string())
+        bad_request("kvmem_gc requires a nonempty token prefix and SHA256", "kvmem_gc");
+    result.prefix_sha256 = proof.at("prefix_sha256").get<std::string>();
+    if (result.prefix_sha256.size() != 64 || std::any_of(result.prefix_sha256.begin(), result.prefix_sha256.end(),
+            [](char c) { return !(c >= '0' && c <= '9') && !(c >= 'a' && c <= 'f'); }))
+        bad_request("kvmem_gc prefix_sha256 must be lowercase hex", "kvmem_gc");
+    if (!proof.contains("steps") || !proof.at("steps").is_array() || proof.at("steps").empty() || proof.at("steps").size() > 64)
+        bad_request("kvmem_gc requires 1..64 steps", "kvmem_gc");
+    for (const auto& row : proof.at("steps")) {
+        require_object(row, "kvmem_gc step must be an object", "kvmem_gc");
+        fields(row, {"id", "kind", "source_begin", "source_end", "result_begin", "result_end", "observation_id", "importance", "cold", "complete"});
+        HistoricalGcStepEvidence step;
+        if (!row.contains("id") || !row.at("id").is_string() || !row.contains("kind") || !row.at("kind").is_string())
+            bad_request("kvmem_gc step requires id and kind", "kvmem_gc");
+        step.id = row.at("id").get<std::string>(); step.kind = row.at("kind").get<std::string>();
+        if (step.id.empty() || step.id.size() > 128 || (step.kind != "thinking" && step.kind != "completed_step" &&
+                step.kind != "tool_detail" && step.kind != "superseded"))
+            bad_request("Invalid kvmem_gc step id or kind", "kvmem_gc");
+        step.source_begin = integer(row, "source_begin", result.prefix_tokens);
+        step.source_end = integer(row, "source_end", result.prefix_tokens);
+        step.result_begin = integer(row, "result_begin", result.prefix_tokens);
+        step.result_end = integer(row, "result_end", result.prefix_tokens);
+        step.observation_id = integer(row, "observation_id", UINT64_MAX);
+        if (!row.contains("importance") || !row.at("importance").is_number() || !row.contains("cold") || !row.contains("complete"))
+            bad_request("kvmem_gc requires explicit observation and completion", "kvmem_gc");
+        step.importance = row.at("importance").get<double>();
+        if (!std::isfinite(step.importance) || step.importance < 0 || step.importance > 1 ||
+            step.source_begin >= step.source_end || step.result_begin >= step.result_end ||
+            (step.source_begin < step.result_end && step.result_begin < step.source_end))
+            bad_request("Invalid kvmem_gc ranges or importance", "kvmem_gc");
+        step.cold = get_bool(row, "cold", false); step.complete = get_bool(row, "complete", false);
+        result.steps.push_back(std::move(step));
+    }
+    return result;
+}
+
+} // namespace ninfer::serve
