+void ProgramImpl::stage_historical_evidence(SequenceState& sequence, const PreparedPromptData& prompt) {
+    auto& window = sequence.window;
+    if (!prompt.historical_gc_evidence && !window.historical_evidence) return;
+    if (!kvmem_options.historical_gc_statistical || !kvmem_window_tokens)
+        throw RequestError(RequestErrorKind::InvalidGcEvidence, "Step evidence requires statistical KVMem GC");
+    if (!window.historical_evidence) window.historical_evidence=make_step_evidence(kvmem_options,capacity);
+    if (prompt.historical_gc_evidence) {
+        const auto& proof = *prompt.historical_gc_evidence;
+        std::vector<kvmem::HistoricalKvStepEvidence::Update> updates;
+        for (const auto& step : proof.steps)
+            updates.push_back({step.id, step.kind, step.source_begin, step.source_end, step.result_begin,
+                step.result_end, step.observation_id, step.importance, step.cold, step.complete});
+        try { window.historical_evidence->publish(updates, proof.prefix_tokens); }
+        catch (const std::invalid_argument& e) { throw RequestError(RequestErrorKind::InvalidGcEvidence, e.what()); }
+    }
+    // Publish revised evidence before this boundary can commit older intents.
+    progress_historical_gc(sequence,false);
+}
