+    const bool handoff = (!backend_kv_pages || sequence.mtp_kv_valid == sequence.text_kv_valid) &&
+        std::any_of(window.pages.begin(), window.pages.end(), [&](auto id) {
+            return window.historical_evidence->handoff_candidate(id) &&
+                id >= kvmem_options.sink_blocks() && id + kvmem_options.recent_blocks() < count;
+        });
+    if (handoff) {
+        window.historical_handoff = true;
+        try {
+            prepare_window(sequence, sequence.text_kv_valid, sequence.text_kv_valid, true, false,
+                kvmem::SelectionReason::DecodePressure);
