diff --git a/src/models/qwen3_5/program/storage/checkpoint_resume.cpp b/src/models/qwen3_5/program/storage/checkpoint_resume.cpp
new file mode 100644
index 0000000..e59f9a0
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/checkpoint_resume.cpp
@@ -0,0 +1,119 @@
+#include "models/qwen3_5/program/storage/checkpoint_resume.h"
+#include "models/qwen3_5/program/storage/historical_state.h"
+#include <array>
+#include <algorithm>
+#include <exception>
+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+[[noreturn]] void fail(kvmem::MemoryErrorCode code, const char* message) {
+    throw kvmem::MemoryError(code, message);
+}
+}
+PreparedCheckpointResume::PreparedCheckpointResume(
+    KvmemCheckpointBufferPool::MetadataCharge charge, kvmem::HostKvRecord rows,
+    const kvmem::SourceJournalStore& owner, kvmem::SourceState source,
+    kvmem::MemoryStamp window, kvmem::MemoryStamp native, std::uint32_t prefix, std::uint32_t reserve,
+    std::uint32_t query_begin, std::uint32_t query_end, std::uint32_t input_end)
+    : charge_(std::move(charge)), rows_(std::move(rows)), owner_(&owner), source_(source),
+      window_(window), native_(native), prefix_(prefix), reserve_(reserve), query_begin_(query_begin),
+      query_end_(query_end), input_end_(input_end) {}
+
+void PreparedCheckpointResume::validate(const kvmem::SourceJournalStore& store,
+    const kvmem::SourceConfiguration& current) const {
+    if (owner_ != &store)
+        fail(kvmem::MemoryErrorCode::Stale, "checkpoint resume belongs to a different Program");
+    const auto state = store.state(source_.ref);
+    if (state.configuration != current || state.configuration != source_.configuration)
+        fail(kvmem::MemoryErrorCode::Unsupported, "checkpoint resume configuration changed");
+    if (!native_.valid || !native_.frontier || native_.frontier >= prefix_ ||
+        prefix_ > state.accepted_frontier || !reserve_ || rows_.size() != std::uint64_t(prefix_) * 4)
+        fail(kvmem::MemoryErrorCode::Stale, "checkpoint resume source/staging is detached");
+}
+void PreparedCheckpointResume::read_tokens(std::span<std::int32_t> out) const {
+    if (out.size() != prefix_) fail(kvmem::MemoryErrorCode::InvalidPlan, "checkpoint resume token span differs");
+    rows_.read(0, out.data(), out.size_bytes());
+}
+void PreparedCheckpointResume::validate_request(const kvmem::SourceJournalStore& store,
+    const kvmem::SourceConfiguration& current, std::span<const std::int32_t> tokens,
+    std::uint64_t output, std::uint64_t workspace, bool allow_reuse, bool branched) const {
+    validate(store,current);
+    if (!allow_reuse || branched)
+        fail(kvmem::MemoryErrorCode::Unsupported, "checkpoint resume requires an unbranched native reuse request");
+    if (output > reserve_ || workspace > reserve_ - output)
+        fail(kvmem::MemoryErrorCode::BudgetExceeded, "checkpoint resume output exceeds prepared reserve");
+    if (tokens.size() != prefix_)
+        fail(kvmem::MemoryErrorCode::InvalidPlan, "checkpoint resume canonical prefix length changed");
+    std::array<std::int32_t,64> block{};
+    for (std::size_t begin=0; begin<tokens.size(); begin+=block.size()) {
+        const auto n=std::min(block.size(),tokens.size()-begin);
+        rows_.read(begin*4,block.data(),n*4);
+        if (!std::equal(block.begin(),block.begin()+n,tokens.begin()+begin))
+            fail(kvmem::MemoryErrorCode::Stale, "checkpoint resume canonical rows changed");
+    }
+}
+bool PreparedCheckpointResume::matches(const KvmemWindowState& window) const noexcept {
+    return window.source == source_.ref && window.stamp == window_;
+}
+kvmem::SourceState PreparedCheckpointResume::branch(kvmem::SourceJournalStore& store,
+    const kvmem::SourceConfiguration& current, std::uint64_t computed) const {
+    validate(store,current);
+    if (computed != native_.frontier)
+        fail(kvmem::MemoryErrorCode::Stale, "checkpoint resume did not restore its quoted frontier");
+    auto child=store.branch(source_.ref,prefix_);
+    try {
+        // branch() deliberately starts computed0. Only the model's completed
+        // native restore authorizes this inherited evaluated frontier.
+        child=store.append(child,nullptr,0,nullptr,0,computed);
+        validate(store,current);
+        return store.state(child);
+    } catch (...) {
+        const auto original=std::current_exception();
+        try { (void)store.forget(child); } catch (...) {}
+        std::rethrow_exception(original);
+    }
+}
+std::shared_ptr<const PreparedCheckpointResume> prepare_kvmem_checkpoint_resume(
+    const kvmem::SourceJournalStore& store, kvmem::SourceRef ref,
+    const kvmem::SourceConfiguration& current, const KvmemWindowState& window,
+    std::uint32_t prefix, std::uint32_t reserve, KvmemCheckpointBufferPool& pool,
+    kvmem::HostKvStorage& recovery) {
+    const auto state=store.state(ref);
+    if (state.configuration!=current)
+        fail(kvmem::MemoryErrorCode::Unsupported,"checkpoint resume source configuration differs");
+    // Continue a canonical source prefix through a complete retained CP.
+    // A suffix row is required to produce logits by the normal Native route.
+    if (!(window.source==ref) || !window.stamp.valid ||
+        !prefix || prefix>state.accepted_frontier || !reserve)
+        fail(kvmem::MemoryErrorCode::Stale,"checkpoint resume needs a current history and a canonical suffix");
+    const KvmemPrefixCheckpoint* selected=nullptr;
+    const auto consider=[&](const auto& r){if (!r.data) return; const auto& cp=*r.data;
+        if (cp.identity.stamp.valid && cp.identity.stamp.session==window.stamp.session && cp.state_bytes() &&
+            cp.prefix.size()==cp.identity.stamp.frontier && cp.prefix.size()>0 && cp.prefix.size()<prefix &&
+            cp.prefix.size()<=state.computed_frontier && (!selected || cp.prefix.size()>selected->prefix.size())) selected=&cp;
+    };
+    // Same finite equal-frontier purpose order as Native restore/publication.
+    for (const auto purpose:{kvmem::CheckpointPurpose::Endpoint,kvmem::CheckpointPurpose::Reconstruction,
+        kvmem::CheckpointPurpose::InputFallback,kvmem::CheckpointPurpose::QueryReplay,kvmem::CheckpointPurpose::ReuseAnchor})
+        if (const auto* r=window.checkpoints.find(purpose)) consider(*r);
+    for (const auto& e:window.coverage) if(e.info.identity) consider(e.record);
+    if (!selected)
+        fail(kvmem::MemoryErrorCode::Stale,"checkpoint resume lost its complete native checkpoint");
+    const auto native=selected->identity.stamp, expected_window=window.stamp;
+    const auto query_begin=std::min(window.query_begin,prefix),query_end=std::min(window.query_end,prefix);
+    const auto input_end=std::min(window.output_begin,prefix);
+    auto charge=pool.reserve_metadata(sizeof(PreparedCheckpointResume)+256);
+    auto reservation=recovery.reserve(std::uint64_t(prefix)*4);
+    auto rows=reservation.allocate(std::uint64_t(prefix)*4);
+    std::array<std::int32_t,64> block{};
+    for (std::uint64_t begin=0;begin<prefix;begin+=block.size()) {
+        const auto n=std::size_t(std::min<std::uint64_t>(block.size(),prefix-begin));
+        store.read_tokens(ref,begin,block.data(),n);rows.write(begin*4,block.data(),n*4);
+    }
+    rows.seal();
+    auto result=std::make_shared<PreparedCheckpointResume>(std::move(charge),std::move(rows),
+        store,state,expected_window,native,prefix,reserve,query_begin,query_end,input_end);
+    result->validate(store,current);
+    return result;
+}
+} // namespace ninfer::models::qwen3_5::detail
