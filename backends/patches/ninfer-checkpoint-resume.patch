+#pragma once
+#include "models/qwen3_5/program/storage/checkpoint_buffer_pool.h"
+#include "kvmem/source_journal.hpp"
+#include <span>
+
+namespace ninfer::models::qwen3_5::detail {
+struct KvmemWindowState;
+
+// A request-local immutable receipt, not a second history catalog. It pins R
+// source rows and its own C metadata, never the history/CP/H owners. Eviction or
+// consumption can therefore invalidate a prepared request before admission.
+class PreparedCheckpointResume {
+public:
+    PreparedCheckpointResume(KvmemCheckpointBufferPool::MetadataCharge charge,
+        kvmem::HostKvRecord rows, const kvmem::SourceJournalStore& owner,
+        kvmem::SourceState source, kvmem::MemoryStamp window, kvmem::MemoryStamp native, std::uint32_t prefix,
+        std::uint32_t reserve, std::uint32_t query_begin, std::uint32_t query_end,
+        std::uint32_t input_end);
+    void validate(const kvmem::SourceJournalStore&, const kvmem::SourceConfiguration&) const;
+    void read_tokens(std::span<std::int32_t>) const;
+    void validate_request(const kvmem::SourceJournalStore&, const kvmem::SourceConfiguration&,
+        std::span<const std::int32_t>, std::uint64_t output, std::uint64_t workspace,
+        bool allow_reuse, bool branched) const;
+    bool matches(const KvmemWindowState&) const noexcept;
+    // Current S is branched only AFTER native restoration. Both S allocations
+    // and the computed-frontier commit may fail; the new child is rolled back.
+    kvmem::SourceState branch(kvmem::SourceJournalStore&,
+        const kvmem::SourceConfiguration&, std::uint64_t computed) const;
+    kvmem::SourceRef source() const noexcept { return source_.ref; }
+    const kvmem::MemoryStamp& native() const noexcept { return native_; }
+    std::uint32_t prefix() const noexcept { return prefix_; }
+    std::uint32_t query_begin() const noexcept { return query_begin_; }
+    std::uint32_t query_end() const noexcept { return query_end_; }
+    std::uint32_t input_end() const noexcept { return input_end_; }
+private:
+    // First member, refunded after the owned rows and all other state die.
+    KvmemCheckpointBufferPool::MetadataCharge charge_;
+    kvmem::HostKvRecord rows_;
+    const kvmem::SourceJournalStore* owner_;
+    kvmem::SourceState source_;
+    kvmem::MemoryStamp window_, native_;
+    std::uint32_t prefix_, reserve_, query_begin_, query_end_, input_end_;
+};
+
+std::shared_ptr<const PreparedCheckpointResume> prepare_kvmem_checkpoint_resume(
+    const kvmem::SourceJournalStore&, kvmem::SourceRef,
+    const kvmem::SourceConfiguration&, const KvmemWindowState&,
+    std::uint32_t prefix, std::uint32_t reserve,
+    KvmemCheckpointBufferPool&, kvmem::HostKvStorage& recovery);
