@@ -0,0 +1,157 @@
+#include "ninfer/engine.h"
+#include "kvmem/memory_contract.hpp"
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+template<class F> void rejected(kvmem::MemoryErrorCode code, F action) {
+    try { action(); }
+    catch (const kvmem::MemoryError& error) { require(error.code() == code, "wrong source-forget rejection"); return; }
+    throw std::runtime_error("source-forget operation unexpectedly succeeded");
+}
+ninfer::RequestOptions request() {
+    ninfer::RequestOptions result;
+    result.execution.requested_output_tokens = 8;
+    result.execution.sampling.temperature = 0;
+    result.execution.sampling.seed = 42;
+    result.execution.thinking.loop = ninfer::ReasoningLoopAction::Off;
+    result.stop.include_model_defaults = false;
+    result.output.raw = result.output.preserve_special_tokens = true;
+    return result;
+}
+struct BusyProbe final : ninfer::OutputSink {
+    ninfer::Engine& engine;
+    ninfer::HistoricalSourceRef source;
+    bool observed = false;
+    BusyProbe(ninfer::Engine& engine, ninfer::HistoricalSourceRef source) : engine(engine), source(source) {}
+    void start(ninfer::GenerationStart) override {}
+    void progress(ninfer::PromptProgress p) override {
+        if (observed || !p.processed_prompt_tokens || p.processed_prompt_tokens >= p.total_prompt_tokens) return;
+        rejected(kvmem::MemoryErrorCode::Pending, [&] { (void)engine.forget_historical_source(source); });
+        const auto records = engine.historical_sources();
+        require(std::any_of(records.begin(), records.end(), [&](const auto& record) { return record.ref == source; }),
+            "busy rejection changed the source family");
+        observed = true;
+    }
+    void timing(ninfer::GenerationTimingObservation) override {}
+    void publish(ninfer::OutputDelta) override {}
+};
+int run() {
+    const char* artifact = std::getenv("NINFER_SOURCE_FORGET_ARTIFACT");
+    if (!artifact || !*artifact) return 77;
+    const bool mtp = std::getenv("NINFER_SOURCE_FORGET_MTP") != nullptr;
+    const bool redundancy = std::getenv("NINFER_SOURCE_FORGET_REDUNDANCY") != nullptr;
+    ninfer::EngineOptions options;
+    options.artifact_path = artifact;
+    options.max_context = 65536;
+    options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(2560);
+    options.prefill_chunk = 512;
+    options.max_concurrency = 1;
+    options.max_pending_requests = 4;
+    options.device_profile = "off";
+    options.context_cache.enabled = false;
+    options.kv_cache = ninfer::KvCacheStorage::RotatedLloyd4KeyInt4Value;
+    options.kvmem.selected_tokens = 2048;
+    options.kvmem.reserve_tokens = 512;
+    options.kvmem.host_bytes = 96ULL << 20;
+    options.kvmem.source_bytes = 16ULL << 20;
+    options.kvmem.recovery_bytes = 8192;
+    options.kvmem.retained_sessions = 8;
+    options.kvmem.query_meanq_cosine = options.kvmem.score_agg_max = true;
+    options.kvmem.graph_alpha = 0;
+    options.kvmem.historical_gc_lru = !redundancy;
+    options.kvmem.historical_gc_redundancy = redundancy;
+    options.kvmem.verify_transfers = true;
+    if (mtp) { options.speculative.backend = ninfer::SpeculativeBackend::Mtp; options.speculative.draft_tokens = 4; }
+    ninfer::Engine engine(options);
+    const auto encoded = engine.tokenize_text(" Memory");
+    require(!encoded.empty(), "source-forget fixture token is empty");
+    // Three 1,024-token domains plus the independent/busy fixtures fit H in
+    // both none and MTP. Larger inputs legitimately evict the root beforehand.
+    const std::vector<ninfer::TokenId> original_ids(1024, encoded.front());
+    const auto original = engine.generate(engine.prepare_tokens(original_ids, true, true), request());
+    require(original.accepted_source.has_value(), "original request lost source receipt");
+    const auto source = *original.accepted_source;
+    const auto child = engine.generate(engine.prepare_source_rebuild(source, 1024, 32), request());
+    require(child.accepted_source.has_value(), "child request lost source receipt");
+    const auto grandchild = engine.generate(engine.prepare_source_rebuild(*child.accepted_source, 1024, 32), request());
+    require(grandchild.accepted_source.has_value(), "grandchild request lost source receipt");
+    auto distinct = std::vector<ninfer::TokenId>(512, encoded.front());
+    const auto alternative = engine.tokenize_text(" unrelated");
+    require(!alternative.empty(), "distinct fixture token is empty");
+    distinct.front() = alternative.front();
+    const auto unrelated = engine.generate(engine.prepare_tokens(distinct, true, true), request());
+    require(unrelated.accepted_source.has_value(), "unrelated request lost source receipt");
+    auto parent_prepared = engine.prepare_source_rebuild(source, 1024, 32);
+    auto descendant_prepared = engine.prepare_source_rebuild(*grandchild.accepted_source, 1024, 32);
+    require(engine.memory_summary().kvmem.recovery_bytes == 8192, "fixture did not retain both real R copies");
+    distinct.resize(768, encoded.front());
+    const auto running = engine.tokenize_text(" running");
+    require(!running.empty(), "running fixture token is empty");
+    distinct.front() = running.front();
+    auto handle = engine.submit(engine.prepare_tokens(distinct), request(), ninfer::OutputConsumerMode::Streaming,
+        {.prompt_progress = true});
+    rejected(kvmem::MemoryErrorCode::Pending, [&] { (void)engine.forget_historical_source(source); });
+    BusyProbe probe(engine, source);
+    const auto busy = handle.wait(&probe);
+    require(probe.observed && busy.accepted_source, "busy guard was not exercised during actual partial prefill");
+    const auto before = engine.historical_sources();
+    const auto memory_before = engine.memory_summary().kvmem;
+    std::cerr << "SOURCE_FORGET_PREFLIGHT sources=" << before.size()
+              << " retained=" << memory_before.retained_sessions
+              << " host_bytes=" << memory_before.host_payload_bytes << std::endl;
+    require(before.size() == 5 && memory_before.retained_sessions == 5, "fixture lost a native checkpoint domain before forget");
+    auto stale = source; ++stale.revision;
+    rejected(kvmem::MemoryErrorCode::Stale, [&] { (void)engine.forget_historical_source(stale); });
+    require(engine.historical_sources().size() == 5 && engine.memory_summary().kvmem.recovery_bytes == 8192,
+        "stale forget changed aliases or preparation charges");
+    const auto forgotten = engine.forget_historical_source(source);
+    const auto after = engine.historical_sources();
+    const auto memory_after = engine.memory_summary().kvmem;
+    require(forgotten.forgotten_sources == 3 && forgotten.discarded_native_domains == 3,
+        "source family did not revoke all three native domains");
+    require(after.size() == 2 && memory_after.retained_sessions == 2 && memory_after.source_bytes < memory_before.source_bytes,
+        "forget did not remove source and retained native aliases");
+    require(memory_after.recovery_bytes == 8192, "revocation refunded still-owned preparation bytes");
+    require(std::any_of(after.begin(), after.end(), [&](const auto& r) {
+        return r.ref == *unrelated.accepted_source && r.retained_native_domains == 1;
+    }), "forget affected an independent source");
+    rejected(kvmem::MemoryErrorCode::Stale, [&] { (void)engine.prepare_source_rebuild(source, 1024, 32); });
+    rejected(kvmem::MemoryErrorCode::Stale, [&] { (void)engine.generate(std::move(parent_prepared), request()); });
+    require(engine.is_available() && engine.memory_summary().kvmem.recovery_bytes == 4096,
+        "revoked parent request damaged Engine or staging ownership");
+    rejected(kvmem::MemoryErrorCode::Stale, [&] { (void)engine.generate(std::move(descendant_prepared), request()); });
+    require(engine.is_available() && engine.memory_summary().kvmem.recovery_bytes == 0 && engine.historical_sources().size() == 2,
+        "revoked descendant published a source or leaked R");
+    const auto last_forgotten = engine.forget_historical_source(*busy.accepted_source);
+    require(last_forgotten.forgotten_sources == 1 && engine.memory_summary().kvmem.source_last_id == 0,
+        "last-source observation retained a forgotten source");
+    const auto fresh = engine.generate(engine.prepare_tokens(original_ids, true, true), request());
+    require(fresh.accepted_source && fresh.accepted_source->id > busy.accepted_source->id && fresh.reused_prompt_tokens == 0,
+        "old checkpoint or identity revived after forget");
+    require(fresh.generated_token_ids == original.generated_token_ids, "fresh canonical input changed after forget");
+    require(!mtp || (original.speculative.rounds && child.speculative.rounds && grandchild.speculative.rounds && fresh.speculative.rounds),
+        "MTP forget qualification ran only ordinary fallback");
+    std::cout << nlohmann::json{{"status", "passed"}, {"mtp", mtp}, {"redundancy", redundancy},
+        {"forgotten_sources", forgotten.forgotten_sources}, {"discarded_native_domains", forgotten.discarded_native_domains},
+        {"sources_before", before.size()}, {"sources_after", after.size()}, {"busy_partial_prefill", probe.observed},
+        {"source_bytes_before", memory_before.source_bytes}, {"source_bytes_after", memory_after.source_bytes},
+        {"host_bytes_before", memory_before.host_payload_bytes}, {"host_bytes_after", memory_after.host_payload_bytes},
+        {"checkpoint_bytes_before", memory_before.checkpoint_bytes}, {"checkpoint_bytes_after", memory_after.checkpoint_bytes},
+        {"revoked_staging_bytes", memory_after.recovery_bytes}, {"final_staging_bytes", engine.memory_summary().kvmem.recovery_bytes},
+        {"fresh_source_id", fresh.accepted_source->id}, {"fresh_reused_tokens", fresh.reused_prompt_tokens},
+        {"fresh_speculative_rounds", fresh.speculative.rounds}, {"output_ids", fresh.generated_token_ids}}.dump() << std::endl;
+    return 0;
+}
+}
+int main() {
+    try { return run(); }
+    catch (const std::exception& error) { std::cerr << "SOURCE_FORGET_FATAL: " << error.what() << std::endl; return 1; }
+}
