+HistoricalSourceForgetResult ProgramImpl::forget_historical_source(HistoricalSourceRef source) {
+    if (!source_journal)
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported, "source recording is disabled");
+    const kvmem::SourceRef ancestor{{source.id, source.incarnation}, source.revision};
+    (void)source_journal->state(ancestor);
+    if (has_context_transaction() || pending_transaction_ || memory_idle_transfer || memory_coverage_transfer ||
+        std::any_of(requests.begin(), requests.end(), [](const auto& request) {
+            return request.lifecycle != Lifecycle::Empty;
+        }))
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::Pending, "source forget requires a quiescent Program");
+    const auto member = [&](kvmem::SourceRef ref) {
+        return ref.source.id && source_journal->family_contains(ancestor, ref.source);
+    };
+    // Construct replacements and validate every owner before changing anything.
+    // The native catalog still owns physical continuations; this API cannot
+    // release its device handles behind ResourceManager's back.
+    std::vector<std::pair<std::size_t, KvmemWindowState>> empty_windows;
+    for (std::size_t i = 0; i < continuation_states.size(); ++i) {
+        const auto& sequence = continuation_states[i];
+        if (!member(sequence.window.source)) continue;
+        if (sequence.kv)
+            throw kvmem::MemoryError(kvmem::MemoryErrorCode::Pending,
+                "source forget requires its native continuations to be released");
+        empty_windows.emplace_back(i, KvmemWindowState{});
+    }
+    std::array<bool, std::tuple_size_v<decltype(memory_histories)>> discard{};
+    HistoricalSourceForgetResult result;
+    for (std::size_t i = 0; i < memory_histories.size(); ++i)
+        if (memory_histories[i] && member(memory_histories[i]->source)) {
+            discard[i] = true;
+            ++result.discarded_native_domains;
+        }
+    const bool clear_last = member(source_last.ref);
+    static_assert(std::is_nothrow_move_assignable_v<KvmemWindowState>);
+    // Nonallocating owner commit: revoke KV/checkpoint/coverage aliases first,
+    // then erase the source family. Monotonic source IDs are never reissued.
+    for (auto& [i, empty] : empty_windows) continuation_states[i].window = std::move(empty);
+    for (std::size_t i = 0; i < discard.size(); ++i)
+        if (discard[i]) memory_histories[i].reset();
+    if (clear_last) { source_last = {}; source_last_tokens_fnv1a64 = 14695981039346656037ULL; }
+    result.forgotten_sources = source_journal->forget(ancestor);
+    advance_resource_revision();
+    if (kvmem_options.verify_transfers)
+        std::fprintf(stderr, "KVMEM_SOURCE_FORGET root=%llu records=%llu native_domains=%llu\n",
+            (unsigned long long)source.id, (unsigned long long)result.forgotten_sources,
+            (unsigned long long)result.discarded_native_domains);
+    return result;
+}
