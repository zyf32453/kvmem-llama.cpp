@@ -0,0 +1,99 @@
+#include "models/qwen3_5/program/storage/checkpoint_publish.h"
+#include <algorithm>
+#include <type_traits>
+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+template<class Work>void each_checkpoint(KvmemWindowState& w,Work work){
+    for(auto& e:w.checkpoints)if(e.data)work(*e.data);
+    for(auto& e:w.coverage)if(e.info.identity && e.record.data)work(*e.record.data);
+}
+std::uint64_t add(std::uint64_t a,std::uint64_t b){
+    if(a>SIZE_MAX || b>SIZE_MAX-a)throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint publication metadata overflow");return a+b;
+}
+[[noreturn]]void invalid(const char* message){throw kvmem::MemoryError(kvmem::MemoryErrorCode::InvalidPlan,message);}
+} // namespace
+
+std::uint64_t kvmem_checkpoint_publication_metadata_bytes(const KvmemCheckpointManifest& m,const KvmemCheckpointInputLimits& limits){
+    if(!m.record_count || m.record_count>kKvmemCheckpointMaximumRecords || m.statistics.size()<52)
+        throw kvmem::SnapshotCorrupt("checkpoint publication has incomplete metadata");
+    std::uint64_t largest=0,frontier=0,tail=0;
+    for(std::size_t i=0;i<m.record_count;++i){const auto& cp=m.records[i];
+        if(cp.graph.size()>SIZE_MAX/4 || cp.feedback.size()>SIZE_MAX/2)
+            throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint graph publication quote overflow");
+        largest=std::max(largest,add(cp.graph.size()*4,cp.feedback.size()*2));
+        frontier=std::max<std::uint64_t>(frontier,cp.prefix.size());tail=std::max<std::uint64_t>(tail,cp.mean_tail.bytes.size());
+    }
+    if(m.selector.size()>SIZE_MAX/2)throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint selector quote overflow");
+    auto bytes=add(add(largest,m.selector.size()*2),add(tail,1024));
+    std::uint64_t raw_blocks=0;std::memcpy(&raw_blocks,m.statistics.data()+44,8);
+    const auto pages=(frontier+63)/64;
+    if(raw_blocks<pages)bytes=add(bytes,kvmem::RawKvStore::mean_snapshot_capacity_bytes(limits.statistics,std::uint32_t(pages*2)));
+    return bytes;
+}
+
+void prepare_kvmem_checkpoint_publication(KvmemCheckpointRead& read,kvmem::SessionIdentity domain){
+    if(!read.window || read.assembly_failed || read.publication_failed || read.publication_prepared || read.published ||
+        !domain.id || !domain.incarnation)invalid("checkpoint publication requires an unused private Window and fresh owner identity");
+    read.publication_failed=true;auto& w=*read.window;
+    if(w.stamp.valid || w.source.source.id || !w.statistics || !w.selector || !w.imported_charge.bytes())
+        invalid("checkpoint publication lost its private state or metadata admission");
+    KvmemPrefixCheckpoint* latest=nullptr;
+    // Same equal-frontier priority as normal native restore.
+    for(const auto purpose:{kvmem::CheckpointPurpose::Endpoint,kvmem::CheckpointPurpose::Reconstruction,
+            kvmem::CheckpointPurpose::InputFallback,kvmem::CheckpointPurpose::QueryReplay,kvmem::CheckpointPurpose::ReuseAnchor}){
+        const auto* e=w.checkpoints.find(purpose);
+        if(e && e->data && (!latest || e->data->prefix.size()>latest->prefix.size()))latest=e->data.get();
+    }
+    for(auto& e:w.coverage)if(e.info.identity && e.record.data && (!latest || e.record.data->prefix.size()>latest->prefix.size()))latest=e.record.data.get();
+    if(!latest || !latest->prefix.size() || latest->prefix.size()>read.manifest.origin.computed_frontier)
+        invalid("checkpoint publication has no complete evaluated boundary");
+    const auto frontier=std::uint32_t(latest->prefix.size());const auto pages=(std::uint64_t(frontier)+63)/64;
+    if(w.archive.size()<pages || w.host_versions.size()<pages || w.retired_pages.size()<pages)
+        throw kvmem::SnapshotCorrupt("checkpoint publication lost its Host page directory");
+    for(std::size_t i=0;i<pages;++i){const auto rows=std::min<std::uint64_t>(64,frontier-i*64);
+        if(!w.retired_pages[i] && (!w.archive[i] || w.host_versions[i]<rows || w.archive[i].size()!=read.manifest.header.page_stride))
+            throw kvmem::SnapshotCorrupt("checkpoint publication has a selectable Host hole or incomplete version");
+    }
+    // The file's top statistics may extend beyond its newest complete CP.
+    // Admit the private graph/feedback copy and selector truncate scratch before
+    // rewinding. The Window retains conservative slack until owner destruction.
+    auto extra=add(latest->graph.bytes(),latest->feedback.bytes());
+    extra=add(extra,std::uint64_t(w.selector->block_count())*2*sizeof(kvmem::KvMemDroppedBlock)+256);
+    if(extra>read.publication_reserved_bytes)
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint normalization exceeded prior publication admission");
+    w.graph={};w.feedback={};
+    auto graph=latest->graph;auto feedback=latest->feedback;
+    graph.include_feedback(feedback.bytes());
+    w.statistics->truncate_to(frontier);w.statistics->restore_mean_checkpoint(frontier,latest->mean_tail);
+    (void)w.selector->truncate_to(frontier);w.selector->restore_retrieval(latest->history);
+    w.graph=std::move(graph);w.feedback.restore(std::move(feedback));w.attention_scope=latest->attention_scope;
+    w.statistics_frontier=frontier;w.archive.resize(pages);w.host_versions.resize(pages);w.retired_pages.resize(pages);w.gc_protected.resize(pages);
+    if(frontier%64)w.host_versions.back()=frontier%64;
+    w.payload_bytes=0;for(const auto& page:w.archive)w.payload_bytes=add(w.payload_bytes,page.size());
+    if(w.historical_features)w.historical_features->truncate_to(frontier,64);
+    if(w.historical_thinking)w.historical_thinking->truncate(frontier);
+    if(w.historical_think_start>=frontier)w.historical_think_start=UINT64_MAX;
+    w.capture_plan=kvmem::CheckpointCapturePlan(frontier,w.coverage.policy().interval,w.capture_plan.root,w.capture_plan.tail);
+    w.reuse_anchor=std::min(w.reuse_anchor,frontier);w.reconstruction_frontier=0;
+    w.stamp={false,domain,1,0,frontier,1};
+    each_checkpoint(w,[&](KvmemPrefixCheckpoint& cp){cp.identity.stamp={false,domain,1,0,cp.prefix.size(),1};});
+    read.publication_prepared=true;read.publication_failed=false;
+}
+
+kvmem::SourceRef publish_kvmem_checkpoint_window(KvmemCheckpointRead& read,std::optional<KvmemWindowState>& target,
+    const std::function<kvmem::SourceRef(std::uint64_t)>& importer){
+    if(!read.window || !read.publication_prepared || read.publication_failed || read.published || target || !importer)
+        invalid("checkpoint publication target or private preparation is stale");
+    read.publication_failed=true;
+    const auto source=importer(read.window->stamp.frontier);
+    // SourceArchive's importer returned a committed current S root. Every
+    // following operation is a bounded plain update/noexcept owner move.
+    static_assert(std::is_nothrow_move_constructible_v<KvmemWindowState> && std::is_nothrow_move_assignable_v<KvmemWindowState>);
+    if(!source.source.id || !source.source.incarnation || !source.revision)std::terminate();
+    auto& w=*read.window;w.source=source;w.stamp.valid=true;w.update_session_index=true;
+    each_checkpoint(w,[](KvmemPrefixCheckpoint& cp){cp.identity.stamp.valid=true;});
+    target=std::move(w);read.window.reset();read.publication_prepared=false;read.publication_failed=false;read.published=true;
+    return source;
+}
+} // namespace ninfer::models::qwen3_5::detail
