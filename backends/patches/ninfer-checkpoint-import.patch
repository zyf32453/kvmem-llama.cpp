+HistoricalSourceRef ProgramImpl::import_historical_checkpoint(HistoricalArchiveKey key) {
+#if defined(__linux__)
+    require_source_control();
+    if(!source_archive || !source_checkpoint_max_bytes || !source_replay_supported() || context_cache.enabled)
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"native checkpoint import is disabled");
+    if(source_archive->bound_source({key.space,key.id},*source_journal))
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::Pending,"archive source already has a live owner binding");
+    auto target=std::find_if(memory_histories.begin(),memory_histories.end(),[](const auto& value){return !value;});
+    if(target==memory_histories.end())
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint import needs a free native history slot");
+    auto read=read_historical_checkpoint(key);
+    prepare_kvmem_checkpoint_publication(*read,allocate_memory_identity());
+    const auto imported=publish_kvmem_checkpoint_window(*read,*target,[&](std::uint64_t frontier){
+        return source_archive->import_checkpoint_source(*read->source,*read->checkpoint,*source_journal,frontier);
+    });
+    advance_resource_revision();
+    return {imported.source.id,imported.source.incarnation,imported.revision};
+#else
+    (void)key;throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"native checkpoint import requires Linux");
+#endif
+}
