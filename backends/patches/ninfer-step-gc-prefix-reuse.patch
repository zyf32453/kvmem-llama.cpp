+
+enum class CheckpointPage { Available, Omit, Missing };
+
+CheckpointPage checkpoint_page(const KvmemWindowState& window, const KvmemPrefixCheckpoint& checkpoint,
+                               std::uint32_t page, std::uint32_t frontier, std::uint32_t recent_blocks) {
+    const auto pages = kv_pages_for_tokens(frontier);
+    if (page >= pages || page >= window.archive.size() || page >= window.host_versions.size())
+        return CheckpointPage::Missing;
+    if (memory_page_selectable(window, page))
+        return window.archive[page] && window.host_versions[page] >= valid_columns(page, frontier)
+            ? CheckpointPage::Available : CheckpointPage::Missing;
+    if (page >= window.retired_witnesses.size() || page >= pages - std::min(pages, std::max(1u, recent_blocks)))
+        return CheckpointPage::Missing;
+    const auto witness = window.retired_witnesses[page];
+    // The append tail (also the MTP bridge row), pre-witness checkpoints, and
+    // checkpoints that lost their retained replacement still require replay.
+    if (!witness.result_end || witness.result_end > frontier || witness.page <= page ||
+        witness.page >= pages || witness.page >= window.archive.size() ||
+        witness.page >= window.host_versions.size() || !memory_page_selectable(window, witness.page) ||
+        !window.archive[witness.page] || window.host_versions[witness.page] != page_tokens ||
+        !std::binary_search(checkpoint.resident_pages.begin(), checkpoint.resident_pages.end(), witness.page))
+        return CheckpointPage::Missing;
+    return CheckpointPage::Omit;
+}
+
+// Re-run only the selector on the same accepted Query scores. The shadow
+// allows verified step retirements and keeps capacity deletions excluded.
+void audit_recall(KvmemWindowState& window, const std::vector<std::uint32_t>& candidates,
+                  const std::vector<double>& scores, std::uint32_t frontier, std::uint32_t budget,
+                  bool applied) {
+    const char* audit = std::getenv("KVMEM_GC_RECALL_AUDIT");
+    if (!audit || std::strcmp(audit, "1") != 0) return;
+    const auto start = std::chrono::steady_clock::now();
+    try {
+        auto shadow_candidates = candidates;
+        auto shadow_scores = scores;
+        for (std::uint32_t page = 0; page < std::min<std::size_t>(kv_pages_for_tokens(frontier),
+                                                               window.retired_witnesses.size()); ++page) {
+            const auto witness = window.retired_witnesses[page];
+            if (!witness.result_end || witness.result_end > frontier || memory_page_selectable(window, page))
+                continue;
+            shadow_candidates.push_back(page);
+            shadow_scores.push_back(window.selector->selection_score(page));
+        }
+        const auto& live = window.query_selected;
+        const auto shadow = shadow_candidates.size() == candidates.size() ? live :
+            window.selector->pick_scored_blocks(shadow_candidates, shadow_scores, window.query_required, budget, true);
+        std::vector<std::uint32_t> added, excluded;
+        std::set_difference(live.begin(), live.end(), shadow.begin(), shadow.end(), std::back_inserter(added));
+        std::set_difference(shadow.begin(), shadow.end(), live.begin(), live.end(), std::back_inserter(excluded));
+        std::size_t duplicates = 0;
+        for (const auto page : excluded) {
+            if (page >= window.retired_witnesses.size()) continue;
+            const auto witness = window.retired_witnesses[page];
+            if (witness.result_end && std::binary_search(shadow.begin(), shadow.end(), witness.page) &&
+                std::binary_search(live.begin(), live.end(), witness.page)) ++duplicates;
+        }
+        std::fprintf(stderr, "KVMEM_RECALL_COMPARE frontier=%u query_tokens=%u budget=%u applied=%u live=%zu shadow=%zu"
+                             " eligible=%zu duplicates_avoided=%zu excluded=%zu added=%zu audit_us=%lld",
+            frontier, window.query_tokens, budget, applied ? 1u : 0u, live.size(), shadow.size(),
+            shadow_candidates.size() - candidates.size(), duplicates, excluded.size(), added.size(),
+            static_cast<long long>(std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - start).count()));
+        if (!added.empty()) {
+            std::fprintf(stderr, " added_ids=");
+            for (const auto page : added) std::fprintf(stderr, "%u,", page);
+        }
+        if (!excluded.empty()) {
+            std::fprintf(stderr, " excluded_ids=");
+            for (const auto page : excluded) std::fprintf(stderr, "%u,", page);
+        }
+        std::fputc('\n', stderr);
+        if (applied) window.recall_audit_added = std::move(added);
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "KVMEM_RECALL_AUDIT failed: %s\n", error.what());
+    }
+}
