diff --git a/tests/test_engine_checkpoint_budget_real.cpp b/tests/test_engine_checkpoint_budget_real.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_engine_checkpoint_budget_real.cpp
@@ -0,0 +1,123 @@
+#include "ninfer/engine.h"
+#include "kvmem/memory_contract.hpp"
+#include <nlohmann/json.hpp>
+#include <algorithm>
+#include <cstdlib>
+#include <iostream>
+#include <stdexcept>
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+ninfer::EngineOptions options(const char* artifact, bool mtp, bool redundancy, std::uint64_t budget) {
+    ninfer::EngineOptions result;
+    result.artifact_path = artifact;
+    result.max_context = 65536;
+    result.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(2560);
+    result.prefill_chunk = 512;
+    result.max_concurrency = 1;
+    result.max_pending_requests = 4;
+    result.device_profile = "off";
+    result.context_cache.enabled = false;
+    result.kv_cache = ninfer::KvCacheStorage::RotatedLloyd4KeyInt4Value;
+    auto& memory = result.kvmem;
+    memory.selected_tokens = 2048; memory.reserve_tokens = 512;
+    memory.host_bytes = 96ULL << 20; memory.checkpoint_bytes = budget;
+    memory.source_bytes = 16ULL << 20; memory.recovery_bytes = 8192;
+    memory.retained_sessions = 8;
+    memory.query_meanq_cosine = memory.score_agg_max = true;
+    memory.graph_alpha = 0;
+    memory.historical_gc_lru = !redundancy; memory.historical_gc_redundancy = redundancy;
+    memory.verify_transfers = true;
+    if (mtp) { result.speculative.backend = ninfer::SpeculativeBackend::Mtp; result.speculative.draft_tokens = 4; }
+    return result;
+}
+ninfer::RequestOptions request(bool reuse = true) {
+    ninfer::RequestOptions result;
+    result.execution.requested_output_tokens = 8;
+    result.execution.allow_prefix_reuse = reuse;
+    result.execution.sampling.temperature = 0;
+    result.execution.sampling.seed = 42;
+    result.execution.thinking.loop = ninfer::ReasoningLoopAction::Off;
+    result.stop.include_model_defaults = false;
+    result.output.raw = result.output.preserve_special_tokens = true;
+    return result;
+}
+void bound(const ninfer::KvmemMemorySummary& memory, std::uint64_t budget) {
+    require(memory.checkpoint_budget_bytes == budget && memory.checkpoint_bytes <= budget &&
+        memory.checkpoint_peak_bytes <= budget, "checkpoint owners exceeded the aggregate C budget");
+    require(memory.checkpoint_bytes == memory.checkpoint_image_bytes + memory.checkpoint_metadata_bytes +
+        memory.checkpoint_staging_reserved_bytes, "checkpoint charge does not reconcile");
+    require(memory.checkpoint_idle_bytes <= memory.checkpoint_image_bytes &&
+        memory.checkpoint_staging_bytes <= memory.checkpoint_staging_reserved_bytes, "checkpoint components disagree");
+}
+int run() {
+    const char* artifact = std::getenv("NINFER_CHECKPOINT_BUDGET_ARTIFACT");
+    if (!artifact || !*artifact) return 77;
+    const bool mtp = std::getenv("NINFER_CHECKPOINT_BUDGET_MTP") != nullptr;
+    const bool redundancy = std::getenv("NINFER_CHECKPOINT_BUDGET_REDUNDANCY") != nullptr;
+    nlohmann::json report{{"mtp", mtp}, {"redundancy", redundancy}};
+    {
+        ninfer::Engine engine(options(artifact, mtp, redundancy, 1ULL << 20));
+        const auto encoded = engine.tokenize_text(" Memory"); require(!encoded.empty(), "fixture token empty");
+        const std::vector<ninfer::TokenId> ids(1024, encoded.front());
+        bool quota = false;
+        try { (void)engine.generate(engine.prepare_tokens(ids, true, true), request()); }
+        catch (const ninfer::RequestError& error) { quota = error.kind() == ninfer::RequestErrorKind::Unavailable; }
+        require(quota && engine.is_available(), "mandatory checkpoint quota failure was not request-local");
+        auto failed = engine.memory_summary().kvmem; bound(failed, 1ULL << 20);
+        require(failed.checkpoint_denied > 0 && failed.checkpoint_image_bytes == 0 && failed.checkpoint_metadata_bytes == 0 &&
+            failed.retained_sessions == 0 && failed.resident_pages == 0 && failed.mtp_resident_pages == 0,
+            "failed checkpoint capture leaked a partial native owner");
+        const auto fresh = engine.generate(engine.prepare_tokens(ids, false), request(false));
+        require(fresh.generated_token_ids.size() == 8 && engine.is_available(), "no-cache followup failed after quota refusal");
+        bound(engine.memory_summary().kvmem, 1ULL << 20);
+        report["mandatory_quota_refused"] = true; report["followup_after_refusal"] = true;
+        report["small_quota_denied"] = failed.checkpoint_denied;
+    }
+    {
+        constexpr std::uint64_t budget = 384ULL << 20;
+        ninfer::Engine engine(options(artifact, mtp, redundancy, budget));
+        const auto encoded = engine.tokenize_text(" Memory"); require(!encoded.empty(), "fixture token empty");
+        const std::vector<ninfer::TokenId> original_ids(1024, encoded.front());
+        std::vector<ninfer::TokenId> expected;
+        ninfer::HistoricalSourceRef source;
+        for (int turn = 0; turn < 8; ++turn) {
+            auto ids = original_ids;
+            if (turn) {
+                const auto changed = engine.tokenize_text(std::string(1, char('a'+turn)));
+                require(!changed.empty() && changed.front() != encoded.front(), "fixture prefixes are not distinct");
+                ids.front() = changed.front();
+            }
+            const auto result = engine.generate(engine.prepare_tokens(std::move(ids), true, true), request());
+            require(result.generated_token_ids.size() == 8 && result.accepted_source, "bounded checkpoint generation failed");
+            require(!mtp || result.speculative.rounds > 0, "MTP pressure used only ordinary fallback");
+            if (!turn) { source = *result.accepted_source; expected = result.generated_token_ids; }
+            bound(engine.memory_summary().kvmem, budget);
+        }
+        const auto records = engine.historical_sources();
+        require(std::any_of(records.begin(), records.end(), [&](const auto& r) {
+            return r.ref == source && r.retained_native_domains == 0;
+        }), "checkpoint pressure did not actually evict the old native domain");
+        require(engine.memory_summary().kvmem.history_evictions > 0, "bounded C did not reclaim old domains");
+        const auto rebuilt = engine.generate(engine.prepare_source_rebuild(source, 1024, 32), request());
+        require(rebuilt.reused_prompt_tokens == 0 && rebuilt.computed_prompt_tokens == 1024 &&
+            rebuilt.generated_token_ids == expected, "source-only rebuild changed under checkpoint pressure");
+        require(!mtp || rebuilt.speculative.rounds > 0, "MTP rebuild ran no speculative round");
+        const auto memory = engine.memory_summary().kvmem; bound(memory, budget);
+        require(memory.recovery_bytes == 0 && engine.is_available(), "bounded checkpoint recovery did not settle");
+        report.update({{"budget_bytes", budget}, {"charged_bytes", memory.checkpoint_bytes},
+            {"peak_bytes", memory.checkpoint_peak_bytes}, {"image_bytes", memory.checkpoint_image_bytes},
+            {"metadata_bytes", memory.checkpoint_metadata_bytes}, {"idle_bytes", memory.checkpoint_idle_bytes},
+            {"history_evictions", memory.history_evictions}, {"rebuild_speculative_rounds", rebuilt.speculative.rounds},
+            {"output_ids", rebuilt.generated_token_ids}, {"status", "passed"}});
+    }
+    std::cout << report.dump() << std::endl;
+    return 0;
+}
+}
+int main() {
+    try { return run(); }
+    catch (const std::exception& error) { std::cerr << "CHECKPOINT_BUDGET_FATAL: " << error.what() << std::endl; return 1; }
+}
