diff --git a/tests/models/qwen3_5/test_checkpoint_budget_contract.cpp b/tests/models/qwen3_5/test_checkpoint_budget_contract.cpp
new file mode 100644
--- /dev/null
+++ b/tests/models/qwen3_5/test_checkpoint_budget_contract.cpp
@@ -0,0 +1,105 @@
+#include "models/qwen3_5/program/program_impl.h"
+#include <cstdlib>
+#include <cstdio>
+#include <limits>
+#include <new>
+#include <stdexcept>
+
+namespace {
+thread_local std::size_t fail_at = SIZE_MAX, allocations = 0;
+void fail_allocation() {
+    if (fail_at != SIZE_MAX && allocations++ == fail_at) {
+        fail_at = SIZE_MAX; throw std::bad_alloc();
+    }
+}
+}
+void* operator new(std::size_t bytes) {
+    fail_allocation();
+    if (auto* p = std::malloc(bytes ? bytes : 1)) return p;
+    throw std::bad_alloc();
+}
+void* operator new[](std::size_t bytes) { return ::operator new(bytes); }
+void operator delete(void* p) noexcept { std::free(p); }
+void operator delete[](void* p) noexcept { std::free(p); }
+void operator delete(void* p, std::size_t) noexcept { std::free(p); }
+void operator delete[](void* p, std::size_t) noexcept { std::free(p); }
+
+#define CHECK(x) do { if (!(x)) throw std::runtime_error(#x); } while (false)
+using namespace ninfer::models::qwen3_5::detail;
+template<class F> void quota(F action) {
+    try { action(); }
+    catch (const kvmem::MemoryError& error) {
+        CHECK(error.code() == kvmem::MemoryErrorCode::BudgetExceeded); return;
+    }
+    throw std::runtime_error("checkpoint quota unexpectedly accepted");
+}
+void shared_quota_and_moves() {
+    auto pool = std::make_shared<KvmemCheckpointBufferPool>(); pool->configure(4096, 0);
+    auto first = pool->reserve_metadata(3072), other = pool->reserve_metadata(1024);
+    CHECK(pool->stats().charged == 4096 && !pool->can_accommodate(1));
+    quota([&] { (void)pool->reserve_metadata(1); });
+    quota([&] { first.resize(3073); });
+    CHECK(first.bytes() == 3072 && pool->stats().charged == 4096);
+    quota([&] { pool->configure(4095, 0); });
+    CHECK(pool->stats().capacity == 4096);
+    other = std::move(first);
+    CHECK(first.bytes() == 0 && other.bytes() == 3072 && pool->stats().charged == 3072);
+    other.resize(1024);
+    CHECK(pool->stats().charged == 1024 && pool->stats().peak == 4096 && pool->stats().denied == 2);
+    other = {};
+    CHECK(pool->stats().charged == 0);
+    pool->configure(SIZE_MAX, 0);
+    auto huge = pool->reserve_metadata(SIZE_MAX - 1);
+    quota([&] { (void)pool->reserve_metadata(2); });
+    CHECK(huge.bytes() == SIZE_MAX - 1);
+}
+void detached_alias_and_metadata_growth() {
+    auto pool = std::make_shared<KvmemCheckpointBufferPool>();
+    auto checkpoint = std::make_shared<KvmemPrefixCheckpoint>();
+    const auto base = checkpoint->metadata_bytes();
+    pool->configure(base + 8*sizeof(double), 0);
+    checkpoint->metadata_charge = pool->reserve_metadata(base);
+    checkpoint->replace_history({std::make_shared<const std::vector<double>>(4), 1, true});
+    CHECK(pool->stats().metadata == checkpoint->metadata_bytes());
+    auto old = checkpoint->history;
+    quota([&] { checkpoint->replace_history({std::make_shared<const std::vector<double>>(9), 2, true}); });
+    CHECK(checkpoint->history.scores == old.scores && checkpoint->history.round == 1);
+    auto alias = checkpoint;
+    const auto charged = pool->stats().charged;
+    checkpoint.reset();
+    CHECK(pool->stats().charged == charged); // directory removal cannot refund a live restore alias
+    alias.reset();
+    CHECK(pool->stats().charged == 0);
+    auto lifetime = pool->reserve_metadata(16);
+    std::weak_ptr<KvmemCheckpointBufferPool> weak = pool;
+    pool.reset(); CHECK(!weak.expired());
+    lifetime = {}; CHECK(weak.expired());
+}
+void real_allocation_failures() {
+    std::size_t faults = 0;
+    bool completed = false;
+    for (std::size_t failure = 0; failure < 32; ++failure) {
+        auto pool = std::make_shared<KvmemCheckpointBufferPool>(); pool->configure(16384, 0);
+        fail_at = failure; allocations = 0;
+        bool failed = false;
+        try {
+            auto charge = pool->reserve_metadata(8192);
+            auto checkpoint = std::make_shared<KvmemPrefixCheckpoint>();
+            checkpoint->metadata_charge = std::move(charge);
+            checkpoint->prefix.assign(32, 7);
+            checkpoint->metadata_charge.resize(checkpoint->metadata_bytes());
+        } catch (const std::bad_alloc&) { failed = true; }
+        fail_at = SIZE_MAX;
+        CHECK(pool->stats().charged == 0 && pool->stats().peak <= pool->stats().capacity);
+        if (failed) ++faults;
+        else { completed = true; break; }
+    }
+    CHECK(completed && faults >= 3);
+    std::printf("checkpoint metadata allocation failures checked: %zu\n", faults);
+}
+int main() {
+    shared_quota_and_moves();
+    detached_alias_and_metadata_growth();
+    real_allocation_failures();
+    std::puts("checkpoint owner budget contracts passed (CPU metadata; no CUDA execution)");
+}
