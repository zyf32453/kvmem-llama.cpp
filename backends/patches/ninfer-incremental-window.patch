+        Address& address = require_active(handle);
+        const auto target = pages_for_tokens(coverage);
+        std::vector<LogicalKVPageHandle> next(target);
+        std::vector<LogicalKVPageHandle> added(target - reuse.size());
+        for (const auto& page : reuse) {
+            next[page.destination] = membership(address, page.source);
+        }
+
+        // Recycle outgoing leases into this address's reservation. Compact the retained
+        // ownership first so the address can still be released if materialization fails.
+        auto keep = reuse.begin();
+        std::uint32_t remaining = 0;
+        for (std::uint32_t slot = 0; slot < address.page_count; ++slot) {
+            const auto page = membership(address, slot);
+            if (keep != reuse.end() && keep->source == slot) {
+                membership(address, remaining++) = page;
+                ++keep;
+            } else {
+                pages_->release_active_reference(page);
+                pages_->dematerialize(page, address.reservation);
