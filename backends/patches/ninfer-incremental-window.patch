+    [[nodiscard]] bool can_rebind_window(KVAddressSpaceHandle handle, std::uint32_t old_frontier,
+                                         std::uint32_t visible, std::uint32_t coverage,
+                                         std::span<const KVWindowPageReuse> reuse) const {
+        if (reuse.empty() || visible > coverage || !active(handle)) { return false; }
+        const Address& address = require_active(handle);
+        if (address.checkpoint_frontier || address.committed_frontier != old_frontier ||
+            pages_for_tokens(coverage) > entitlement(address)) {
+            return false;
+        }
+        const auto full_sources = old_frontier / kPagedKVPageSize;
+        const auto full_destinations = visible / kPagedKVPageSize;
+        auto keep = reuse.begin();
+        std::uint32_t first_destination = 0;
+        for (std::uint32_t slot = 0; slot < address.page_count; ++slot) {
+            const auto page = membership(address, slot);
+            if (keep != reuse.end() && keep->source == slot) {
+                if (slot >= full_sources || keep->destination < first_destination ||
+                    keep->destination >= full_destinations || !pages_->device_resident(page) ||
+                    pages_->committed_columns(page) != kPagedKVPageSize) {
+                    return false;
+                }
+                first_destination = keep->destination + 1;
+                ++keep;
+            } else if (!pages_->can_dematerialize(page)) {
+                return false;
+            }
+        }
+        return keep == reuse.end();
+    }
