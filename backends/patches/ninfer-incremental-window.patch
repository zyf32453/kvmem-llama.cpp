+            if (!next[slot].valid()) {
+                next[slot] = *fresh++;
+                pages_->retain_active_reference(next[slot]);
+            }
+            membership(address, slot) = next[slot];
+        }
+        address.page_count = target;
+        publish_membership(address, stream);
+    }
