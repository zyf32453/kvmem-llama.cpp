+namespace ninfer::models::qwen3_5::detail {
+namespace {
+std::uint64_t add(std::uint64_t a,std::uint64_t b){
+    if(a>SIZE_MAX || b>SIZE_MAX-a)throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint window metadata overflow");
+    return a+b;
+}
+template<class T>std::vector<T> copy(KvmemCheckpointArray<T> view){
+    std::vector<T> result(view.size());if(!view.bytes.empty())std::memcpy(result.data(),view.bytes.data(),view.bytes.size());return result;
+}
+std::size_t identity_bytes(const kvmem::MemoryDescriptor& d){
+    return d.identity.backend.capacity()+d.identity.revision.capacity()+d.identity.model.capacity()+
+        d.identity.state_schema.capacity()+d.layout.format.capacity()+5+d.layout.planes.capacity()*sizeof(kvmem::PayloadPlane);
+}
+} // namespace
+
+std::uint64_t kvmem_checkpoint_window_metadata_bytes(const KvmemCheckpointManifest& m,const kvmem::MemoryDescriptor& descriptor){
+    if(!m.record_count || m.record_count>kKvmemCheckpointMaximumRecords || m.coverage_slots>kKvmemCheckpointMaximumCoverageSlots)
+        throw kvmem::SnapshotCorrupt("checkpoint assembly metadata geometry mismatch");
+    auto extra=std::uint64_t(sizeof(KvmemWindowState)+5*sizeof(KvmemCheckpointRecord)+256);
+    extra=add(extra,m.coverage_slots*(sizeof(kvmem::CheckpointArchive<KvmemCheckpointRecord>::Entry)+sizeof(std::uint64_t)));
+    extra=add(extra,m.host_versions.bytes.size());
+    for(std::size_t i=0;i<m.record_count;++i)
+        extra=add(extra,sizeof(KvmemPrefixCheckpoint)+identity_bytes(descriptor)+sizeof(kvmem::GraphSnapshot)+320);
+    return extra;
+}
+
+void assemble_kvmem_checkpoint_window(KvmemCheckpointRead& read,const kvmem::MemoryDescriptor& descriptor,
+    kvmem::CheckpointPolicy policy,std::shared_ptr<kvmem::GraphStatisticsBudget> graph_parent,
+    std::shared_ptr<kvmem::HistoricalKvAuxBudget> auxiliary){
+    if(!read.logical || read.window || read.assembly_failed || !read.read_metadata_bytes || !graph_parent || !auxiliary)
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::InvalidPlan,"checkpoint assembly requires a private logical read and current budgets");
+    const auto& m=read.manifest;auto& logical=*read.logical;
+    if(!m.record_count || m.record_count>kKvmemCheckpointMaximumRecords || m.primary_count>m.primary.size() ||
+        m.coverage_slots>kKvmemCheckpointMaximumCoverageSlots || m.record_count!=logical.records.size() ||
+        read.images.size()!=m.header.images || read.pages.size()!=m.header.page_slots)
+        throw kvmem::SnapshotCorrupt("checkpoint assembly lost private dependencies");
+    read.assembly_failed=true;
+    const auto admitted=add(add(read.read_metadata_bytes,logical.admitted_metadata_bytes),
+        kvmem_checkpoint_window_metadata_bytes(m,descriptor));
+    if(read.metadata_charge.bytes()<admitted)
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"checkpoint native metadata was not admitted before payload I/O");
+    auto window=std::make_unique<KvmemWindowState>();
+    // This child matches normal per-history graph admission. Each snapshot
+    // retains its own logical graph + feedback charge under the same parent.
+    auto graph=std::make_shared<kvmem::GraphStatisticsBudget>(32u<<20,std::move(graph_parent));
+    window->statistics=std::move(logical.statistics);window->selector=std::move(logical.selector);
+    window->query_rows=std::move(logical.query_rows);window->graph=std::move(logical.graph);
+    window->feedback=std::move(logical.feedback);window->attention_scope=logical.attention_scope;
+    window->graph.set_budget(graph);window->graph.include_feedback(window->feedback.snapshot().bytes());
+    window->output_begin=logical.output_begin;window->request_messages=std::move(logical.request_messages);
+    window->think_open=logical.think_open;window->think_close=logical.think_close;
+    window->query_begin=logical.query_begin;window->query_end=logical.query_end;
+    window->capture_plan=logical.capture_plan;window->reuse_anchor=logical.reuse_anchor;
+    window->statistics_frontier=m.statistics_frontier;window->historical_think_start=m.historical_think_start;
+    window->historical_features=std::move(logical.features);window->historical_thinking=std::move(logical.thinking);
+    window->archive=std::move(read.pages);window->host_versions=copy(m.host_versions);
+    for(const auto& page:window->archive)window->payload_bytes=add(window->payload_bytes,page.size());
+    window->bind_historical_budget(auxiliary);
+    window->retired_pages.resize(m.retired_pages.size());window->gc_protected.resize(m.protected_pages.size());
+    for(std::size_t i=0;i<m.retired_pages.size();++i)window->retired_pages[i]=m.retired_pages[i];
+    for(std::size_t i=0;i<m.protected_pages.size();++i)window->gc_protected[i]=m.protected_pages[i];
+    // Old physical view, publication key and query execution state are not
+    // current permits. A future normal restore builds the selected view anew.
+    window->source={};window->stamp={};window->session_key.reset();window->publication_order=0;
+    window->update_session_index=false;
+    std::array<std::shared_ptr<KvmemPrefixCheckpoint>,kKvmemCheckpointMaximumRecords> records{};
+    for(std::size_t i=0;i<m.record_count;++i){auto& from=logical.records[i];
+        if(from.image>=read.images.size() || !read.images[from.image] || read.images[from.image]->size()!=m.header.image_bytes)
+            throw kvmem::SnapshotCorrupt("checkpoint assembly state image mismatch");
+        auto cp=std::make_shared<KvmemPrefixCheckpoint>();
+        cp->identity.backend=descriptor.identity;cp->identity.layout=descriptor.layout;
+        cp->identity.stamp={};cp->identity.stamp.frontier=from.prefix.size();
+        cp->prefix=std::move(from.prefix);
+        cp->prefix_identity.restore(std::move(from.token_types),std::move(from.positions),{},std::move(from.rewrite_frontiers));
+        cp->resident_pages=std::move(from.resident_pages);cp->mean_tail=std::move(from.mean_tail);cp->history=std::move(from.history);
+        cp->graph=std::move(from.graph);cp->feedback=std::move(from.feedback);cp->attention_scope=from.attention_scope;
+        cp->graph.set_budget(graph);cp->graph.include_feedback(cp->feedback.bytes());cp->state=read.images[from.image];
+        cp->metadata_charge=read.metadata_charge.split(add(cp->metadata_bytes(),64));records[i]=std::move(cp);
+    }
+    for(std::size_t i=0;i<m.primary_count;++i){const auto& entry=m.primary[i];
+        if(entry.record>=m.record_count)throw kvmem::SnapshotCorrupt("checkpoint assembly primary dependency missing");
+        const auto purpose=kvmem::CheckpointPurpose(entry.purposes);
+        window->checkpoints.slot(purpose)={purpose,records[entry.record]};
+    }
+    window->coverage=kvmem::CheckpointArchive<KvmemCheckpointRecord>(policy);
+    std::vector<kvmem::CheckpointArchive<KvmemCheckpointRecord>::Entry> coverage(m.coverage_slots);
+    for(std::size_t i=0;i<m.coverage_slots;++i){const auto& entry=m.coverage[i];if(entry.record==UINT64_MAX)continue;
+        if(entry.record>=m.record_count)throw kvmem::SnapshotCorrupt("checkpoint assembly coverage dependency missing");
+        auto& target=coverage[i];target.record={kvmem::CheckpointPurpose(entry.purposes),records[entry.record]};
+        const auto info=target.record.checkpoint_info();
+        target.info={info.frontier,info.bytes,entry.used,info.storage,kvmem::CoveragePurpose(entry.coverage_purpose),entry.protections};
+    }
+    window->coverage.restore_entries(std::move(coverage));
+    // Split charges, not data ownership assumptions: a detached CP alias keeps
+    // its own C and image owners when this window is subsequently destroyed.
+    read.logical.reset();
+    if(read.metadata_charge.bytes()<read.read_metadata_bytes)
+        throw std::logic_error("checkpoint assembly consumed the private reader's metadata admission");
+    window->imported_charge=read.metadata_charge.split(read.metadata_charge.bytes()-read.read_metadata_bytes);
+    read.window=std::move(window);
+    read.assembly_failed=false;
+}
+} // namespace ninfer::models::qwen3_5::detail
