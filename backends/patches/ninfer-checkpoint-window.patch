+// Creates an already decoded PRIVATE data fixture; it has no archive receipt.
+// Source/checksum authorization belongs to the separately tested file adapter.
+std::unique_ptr<KvmemCheckpointRead> private_read(const Fixture& fixture,Accounts& a,bool shared_image=false){
+    auto limits=fixture.limits();limits.statistics.payload_storage=std::make_shared<kvmem::HostKvStorage>(a.h);
+    const auto control=sizeof(KvmemCheckpointRead)+256+kKvmemCheckpointMaximumRecords*sizeof(std::shared_ptr<ninfer::PinnedHostBuffer>)+
+        4*sizeof(kvmem::HostKvRecord);
+    auto charge=a.c->reserve_metadata(control+fixture.metadata.size());
+    auto read=std::make_unique<KvmemCheckpointRead>();read->metadata_charge=std::move(charge);
+    read->read_metadata_bytes=control+fixture.metadata.size();read->metadata=fixture.metadata;
+    auto header=read_kvmem_checkpoint_header(std::span<const std::uint8_t>(fixture.packet).first(64),limits);
+    if(shared_image){header.images=1;const std::uint64_t zero=0;
+        std::memcpy(read->metadata.data()+fixture.offsets.at("cp1_image")-64,&zero,8);}
+    read->manifest=read_kvmem_checkpoint_metadata(read->metadata,header,limits);
+    kvmem::KvMemStoreConfig cfg;cfg.block_tokens=64;cfg.select_budget=128;cfg.sink_blocks=0;cfg.lrfu=true;
+    const auto native=kvmem_checkpoint_window_metadata_bytes(read->manifest,fixture.descriptor);
+    read->logical=prepare_kvmem_checkpoint_state(read->manifest,limits,cfg,a.m,[&](auto bytes){read->metadata_charge.resize(read->read_metadata_bytes+bytes+native);});
+    a.c->require_images_available(header.images,17);
+    for(unsigned image=0;image<header.images;++image){auto buffer=a.c->acquire(17);
+        for(unsigned j=0;j<17;++j)static_cast<std::uint8_t*>(buffer->data())[j]=std::uint8_t(0x20+image*0x40+j);
+        read->images.push_back(std::move(buffer));}
+    read->pages.resize(3);auto reservation=a.h.reserve(22);
