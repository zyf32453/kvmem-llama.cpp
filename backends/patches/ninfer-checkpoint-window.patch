+// CPU-only physical buffer stand-in for standalone logical/window tests.
+// Production/Engine targets never link this file. It deliberately performs no
+// CUDA registration, transfers, synchronization or pinned-memory qualification.
+#include "core/arena.h"
+#include <cstdlib>
+#include <new>
+#include <utility>
+namespace ninfer {
+PinnedHostBuffer::PinnedHostBuffer(std::size_t bytes):size_(bytes){
+    data_=std::malloc(bytes ? bytes : 1);if(!data_)throw std::bad_alloc();
+}
+PinnedHostBuffer::~PinnedHostBuffer(){std::free(data_);}
+PinnedHostBuffer::PinnedHostBuffer(PinnedHostBuffer&& other) noexcept:
