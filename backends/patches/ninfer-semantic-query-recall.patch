+bool ProgramImpl::memory_query_needs_recall(const SequenceState& sequence, std::uint32_t prompt_tokens) const {
+    const auto& window = sequence.window;
+    const auto workspace=backend_kv_pages ? std::max(draft_window,ngram_draft_window)+draft_window : 0;
+    if (std::uint64_t(prompt_tokens)+workspace>std::uint64_t(kvmem_window_tokens)+window.removed_tokens)
+        return true;
+    if (!window.removed_tokens) return false;
+
+    // Missing pressure-evicted rows can still be recalled. Skip the probe
+    // only when every absent row belongs to a fully retired proactive page
+    // with an accepted witness. That proves the view has no recallable hole.
+    const auto end = std::min<std::size_t>(window.retired_witnesses.size(),
+        sequence.text_kv_valid / page_tokens);
+    std::uint64_t retired_tokens = 0;
+    for (std::size_t id = 0; id < end; ++id) {
+        const auto witness_end = window.retired_witnesses[id].result_end;
+        if (witness_end && witness_end <= sequence.text_kv_valid &&
+            !std::binary_search(window.pages.begin(), window.pages.end(), id))
+            retired_tokens += page_tokens;
+    }
+    return retired_tokens != window.removed_tokens;
+}
