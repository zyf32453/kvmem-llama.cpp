+kvmem::SourceArchiveCheckpointInput freeze(ProgramImpl& program,const KvmemWindowState& w,
+                                          const kvmem::SourceState& source) {
+    if(w.historical_gc || w.pending_append || w.pending_window ||
+        (w.pending_window_io && !w.pending_window_io.ready()) || !w.stamp.valid || !w.statistics || !w.selector)
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::Pending,"native checkpoint requires a settled retained history");
+    const auto d=program.memory_descriptor();const auto dir=directory(program,w,source,d);
+    // Reserve all owner/container control before allocation. The metadata byte
+    // image is admitted separately after its allocation-free sizing pass.
+    const auto control=sizeof(FrozenCheckpoint)+sizeof(kvmem::SourceArchiveCheckpointInput)+
+        KvmemCheckpointExportLease::control_bytes()+
+        dir.count*sizeof(std::shared_ptr<PinnedHostBuffer>)+w.archive.size()*sizeof(kvmem::HostKvLease);
+    auto charge=program.memory_checkpoint_pool->reserve_metadata(control);
+    auto frozen=std::make_shared<FrozenCheckpoint>();frozen->charge=std::move(charge);
+    frozen->images.reserve(dir.count);frozen->pages.reserve(w.archive.size());
+    std::uint64_t images=0,host=0;
+    for(std::size_t i=0;i<dir.count;++i) {
+        const auto& state=dir.checkpoints[i]->state;
+        if(std::find(frozen->images.begin(),frozen->images.end(),state)==frozen->images.end()) {
+            frozen->images.push_back(state);images=add(images,state->size());
+        }
+    }
+    const auto stride=d.layout.record_bytes;
+    for(std::size_t id=0;id<w.archive.size();++id) {
+        const auto& page=w.archive[id];
+        const bool legal=memory_page_selectable(w,static_cast<std::uint32_t>(id));
+        if(page && legal && (page.size()!=stride || page.mutable_resident()))
+            throw std::logic_error("retained native page is mutable or malformed");
+        // A retired page can still have a physical reader. Its bytes must not
+        // enter a new durable payload, even while the old H charge remains.
+        auto lease=page && legal ? page.lease() : kvmem::HostKvLease{};
+        if(lease && !lease.data())throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"native checkpoint save requires RAM pages");
+        host=add(host,lease.size());frozen->pages.push_back(std::move(lease));
+    }
+    Writer sizing;metadata(sizing,w,source,dir,*frozen,d);
+    const auto payload=add(add(sizeof(frozen->header),sizing.bytes()),add(images,host));
+    if(payload>SIZE_MAX || payload>UINT64_MAX-104 || payload+104>program.source_checkpoint_max_bytes)
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"native checkpoint exceeds configured frame limit");
+    frozen->charge.resize(add(control,sizing.bytes()));
+    frozen->metadata.reserve(static_cast<std::size_t>(sizing.bytes()));
+    Writer encoded([&](const void* p,std::size_t n){
+        if(n>sizing.bytes()-frozen->metadata.size())throw std::logic_error("native checkpoint metadata grew after sizing");
+        const auto* begin=static_cast<const std::uint8_t*>(p);frozen->metadata.insert(frozen->metadata.end(),begin,begin+n);
+    });
+    metadata(encoded,w,source,dir,*frozen,d);
+    if(encoded.bytes()!=sizing.bytes())throw std::logic_error("native checkpoint metadata changed during freeze");
+    const auto actual=sizeof(FrozenCheckpoint)+sizeof(kvmem::SourceArchiveCheckpointInput)+
+        KvmemCheckpointExportLease::control_bytes()+
+        frozen->images.capacity()*sizeof(frozen->images[0])+frozen->pages.capacity()*sizeof(frozen->pages[0])+frozen->metadata.capacity();
+    if(actual>frozen->charge.bytes())throw std::logic_error("native checkpoint export exceeded metadata admission");
+    frozen->charge.resize(actual);
+    frozen->header={magic,1,0x0102030405060708ULL,sizing.bytes(),
+        program.state_images->host_layout().image_bytes,std::uint64_t(frozen->images.size()),stride,std::uint64_t(frozen->pages.size())};
+    // Source configuration binds model/frontend/execution; add exact native
+    // representation, state layout and finite checkpoint policy, including endian.
+    std::array<std::uint8_t,65536> schema_bytes{};std::size_t used=0;
+    Writer schema([&](const void* p,std::size_t n){
+        if(n>schema_bytes.size()-used)throw std::logic_error("native checkpoint schema exceeds fixed bound");
+        std::memcpy(schema_bytes.data()+used,p,n);used+=n;
+    });
+    schema.scalar(magic);schema.scalar(std::uint32_t(1));schema.scalar(std::uint8_t(std::endian::native==std::endian::little));
+    schema.write(source.configuration.data(),source.configuration.size());descriptor(schema,d);
+    schema.scalar(frozen->header[4]);policy(schema,w.coverage.policy());
+    const auto digest=frontend::sha256(std::span<const std::uint8_t>(schema_bytes).first(used));
+    const auto retained=add(add(actual,images),host);
+    if(retained<payload)throw std::logic_error("native checkpoint retained footprint underdeclared");
+    if(program.kvmem_options.verify_transfers)std::fprintf(stderr,
+        "KVMEM_CHECKPOINT_EXPORT payload_bytes=%llu retained_bytes=%llu metadata_bytes=%llu native_images=%zu host_bytes=%llu checkpoints=%zu invalid_checkpoints=%llu\n",
+        (unsigned long long)payload,(unsigned long long)retained,(unsigned long long)sizing.bytes(),frozen->images.size(),
+        (unsigned long long)host,dir.count,(unsigned long long)dir.dropped);
+    return {digest,payload,retained,frozen,[frozen](const Writer::Sink& sink){frozen->write(sink);}};
+}
