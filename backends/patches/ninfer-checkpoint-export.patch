diff --git a/src/models/qwen3_5/program/storage/checkpoint_export_lease.h b/src/models/qwen3_5/program/storage/checkpoint_export_lease.h
new file mode 100644
index 0000000..129389e
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/checkpoint_export_lease.h
@@ -0,0 +1,41 @@
+#pragma once
+#include "kvmem/source_archive.hpp"
+#include <atomic>
+#include <memory>
+
+namespace ninfer::models::qwen3_5::detail {
+// A single Program-owned export lease. The file worker drops every payload
+// reference BEFORE signalling; only the Engine owner may then release this
+// lease, so pinned-buffer destruction cannot call CUDA from an I/O thread.
+class KvmemCheckpointExportLease {
+    struct Queued {
+        std::shared_ptr<const void> payload;
+        std::function<void(const kvmem::SnapshotWriter::Sink&)> write;
+    };
+    std::shared_ptr<const void> payload_;
+    std::shared_ptr<std::atomic<bool>> released_;
+    KvmemCheckpointExportLease()=default;
+public:
+    KvmemCheckpointExportLease(const KvmemCheckpointExportLease&)=delete;
+    KvmemCheckpointExportLease& operator=(const KvmemCheckpointExportLease&)=delete;
+    static constexpr std::size_t control_bytes() {
+        return sizeof(KvmemCheckpointExportLease)+sizeof(Queued)+256;
+    }
+    static std::unique_ptr<KvmemCheckpointExportLease> capture(kvmem::SourceArchiveCheckpointInput& input) {
+        if(!input.owner || !input.write)
+            throw kvmem::MemoryError(kvmem::MemoryErrorCode::InvalidPlan,"checkpoint export requires an immutable producer");
+        auto lease=std::unique_ptr<KvmemCheckpointExportLease>(new KvmemCheckpointExportLease());
+        lease->payload_=input.owner;
+        lease->released_=std::make_shared<std::atomic<bool>>(false);
+        auto queued=std::shared_ptr<Queued>(new Queued{std::move(input.owner),std::move(input.write)},
+            [released=lease->released_](Queued* value)noexcept{
+                delete value; // producer closure AND its immutable payload
+                released->store(true,std::memory_order_release);
+            });
+        input.owner=queued;
+        input.write=[queued](const kvmem::SnapshotWriter::Sink& sink){queued->write(sink);};
+        return lease;
+    }
+    bool ready()const noexcept{return released_->load(std::memory_order_acquire);}
+};
+} // namespace ninfer::models::qwen3_5::detail
