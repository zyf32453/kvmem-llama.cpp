+namespace {
+using Writer = kvmem::SnapshotWriter;
+using Checkpoint = KvmemPrefixCheckpoint;
+constexpr std::uint64_t magic = 0x315043564b4e494eULL; // NINKVCP1
+constexpr std::size_t maximum_checkpoints = 5+256;
+
+std::uint64_t add(std::uint64_t a,std::uint64_t b) {
+    if (b>UINT64_MAX-a) throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,"native checkpoint size overflow");
+    return a+b;
+}
+void text(Writer& out,std::string_view s) { out.scalar(std::uint64_t(s.size()));out.write(s.data(),s.size()); }
+template<class T,class A> void values(Writer& out,const std::vector<T,A>& v) {
+    static_assert(std::is_arithmetic_v<T>);
+    out.scalar(std::uint64_t(v.size()));out.write(v.data(),std::uint64_t(v.size())*sizeof(T));
+}
+void source_ref(Writer& out,kvmem::SourceRef ref) {
+    out.scalar(ref.source.id);out.scalar(ref.source.incarnation);out.scalar(ref.revision);
+}
+void stamp(Writer& out,const kvmem::MemoryStamp& s) {
+    out.scalar(std::uint8_t(s.valid));out.scalar(s.session.id);out.scalar(s.session.incarnation);
+    out.scalar(s.history_revision);out.scalar(s.view_version);out.scalar(s.frontier);out.scalar(s.execution_history);
+}
+void policy(Writer& out,const kvmem::CheckpointPolicy& p) {
+    out.scalar(std::uint8_t(p.enabled));out.scalar(p.interval);out.scalar(p.min_gap);
+    out.scalar(std::uint64_t(p.count));out.scalar(p.bytes);out.scalar(std::uint64_t(p.hot_count));out.scalar(p.host_bytes);
+}
+void descriptor(Writer& out,const kvmem::MemoryDescriptor& d) {
+    text(out,d.identity.backend);text(out,d.identity.revision);text(out,d.identity.model);text(out,d.identity.state_schema);
+    const auto& l=d.layout;text(out,l.format);out.scalar(l.version);out.scalar(l.block_tokens);
+    out.scalar(l.record_bytes);out.scalar(l.alignment);out.scalar(std::uint64_t(l.planes.size()));
+    for(const auto& p:l.planes) {
+        out.scalar(p.layer);out.scalar(std::uint32_t(p.kind));out.scalar(p.offset);out.scalar(p.bytes);
+        out.scalar(p.alignment);out.scalar(p.token_stride);
+    }
+}
+void messages(Writer& out,const std::shared_ptr<const std::vector<kvmem::GraphMessageSpan>>& spans) {
+    out.scalar(std::uint8_t(bool(spans)));
+    if(!spans)return;
+    out.scalar(std::uint64_t(spans->size()));
+    for(const auto& span:*spans){out.scalar(span.begin);out.scalar(span.end);out.scalar(std::uint8_t(span.end_known));}
+}
+void edges(Writer& out,const std::vector<kvmem::GraphEdge>& edges) {
+    out.scalar(std::uint64_t(edges.size()));for(const auto& e:edges){out.scalar(e.target);out.scalar(e.mass);}
+}
+void graph(Writer& out,const kvmem::GraphSnapshot& g) {
+    out.scalar(g.accepted_through);out.scalar(g.completed_through);out.scalar(g.revision);out.scalar(g.epoch);out.scalar(g.block_tokens);
+    out.scalar(std::uint64_t(g.chunks.size()));
+    for(const auto& chunk:g.chunks) {
+        out.scalar(std::uint8_t(bool(chunk)));
+        if(!chunk)continue;
+        out.scalar(std::uint64_t(chunk->size()));
+        for(const auto& row:*chunk){out.scalar(row.source);out.scalar(row.samples);edges(out,row.edges);}
+    }
+    out.scalar(g.partial.source);out.scalar(g.partial.samples);edges(out,g.partial.mass);messages(out,g.messages);
+}
+void feedback(Writer& out,const kvmem::AttentionFeedbackSnapshot& f) {
+    for(const auto* values:{&f.output,&f.pending_output}) {
+        out.scalar(std::uint64_t(values->size()));for(const auto& [page,mass]:*values){out.scalar(page);out.scalar(mass);}
+    }
+    out.scalar(std::uint64_t(f.prefill.size()));
+    for(const auto& [page,mass]:f.prefill){out.scalar(page);out.scalar(mass.mass);out.scalar(mass.exposure);}
+    out.scalar(f.output_samples);out.scalar(f.prefill_end);
+}
+void scope(Writer& out,const kvmem::OutputSampleState& s){out.scalar(std::uint8_t(s.thinking));out.scalar(s.eligible_tokens);}
+void identity(Writer& out,const ResidentPrefixIdentity& p) {
+    if(!p.vision_items().empty())throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"native checkpoint archive supports text only");
+    values(out,p.token_types());for(std::size_t i=0;i<3;++i)values(out,p.position_axis(i));
+    values(out,p.rewrite_execution_frontiers());
+}
+
+// The queued owner contains no Program/window/RawKvStore pointer. Mutable CPU
+// metadata is copied under the idle Engine owner. Only sealed H and immutable
+// C images are shared with the file worker, retaining their original accounts.
+struct FrozenCheckpoint {
+    KvmemCheckpointBufferPool::MetadataCharge charge;
+    std::array<std::uint64_t,8> header{};
+    std::vector<std::uint8_t> metadata;
+    std::vector<std::shared_ptr<PinnedHostBuffer>> images;
+    std::vector<kvmem::HostKvLease> pages;
+    void write(const Writer::Sink& sink)const {
+        sink(header.data(),sizeof(header));
+        if(!metadata.empty())sink(metadata.data(),metadata.size());
+        // Bound individual producer calls even for very large state images.
+        const auto emit=[&](const void* p,std::size_t n){
+            auto* bytes=static_cast<const std::uint8_t*>(p);
+            while(n){const auto take=std::min(n,kvmem::snapshot_chunk);sink(bytes,take);bytes+=take;n-=take;}
+        };
+        for(const auto& image:images)emit(image->data(),image->size());
+        for(const auto& page:pages)if(page)emit(page.data(),page.size());
+    }
+};
+struct Directory {
+    std::array<const Checkpoint*,maximum_checkpoints> checkpoints{};
+    std::size_t count=0;
+    std::uint64_t dropped=0;
+    std::uint64_t index(const Checkpoint* cp)const {
+        const auto end=checkpoints.begin()+count;
+        const auto found=std::find(checkpoints.begin(),end,cp);
+        return found==end ? UINT64_MAX : std::uint64_t(found-checkpoints.begin());
+    }
+};
+
+Directory directory(ProgramImpl& program,const KvmemWindowState& window,const kvmem::SourceState& source,
+                    const kvmem::MemoryDescriptor& d) {
+    Directory result;
+    const auto consider=[&](const std::shared_ptr<Checkpoint>& pointer){
+        if(!pointer || result.index(pointer.get())!=UINT64_MAX)return;
+        const auto& cp=*pointer;
+        const auto frontier=cp.prefix.size();
+        bool legal=frontier && frontier<=source.computed_frontier && frontier<=window.statistics_frontier &&
+            cp.identity.stamp.valid && cp.identity.stamp.session==window.stamp.session &&
+            cp.identity.stamp.frontier==frontier && cp.identity.backend==d.identity && cp.identity.layout==d.layout &&
+            cp.prefix_identity.size()==frontier && cp.state && !cp.cold_state.size() &&
+            cp.graph.accepted_through==frontier && cp.graph.block_tokens==64 &&
+            cp.state->size()==program.state_images->host_layout().image_bytes;
+        for(auto id:cp.resident_pages) {
+            if(!legal)break;
+            const auto begin=id*64;
+            legal=id<window.archive.size() && id<window.host_versions.size() && begin<frontier &&
+                memory_page_selectable(window,static_cast<std::uint32_t>(id)) && window.archive[id] &&
+                window.host_versions[id]>=std::min<std::uint64_t>(64,frontier-begin);
+        }
+        if(!legal){++result.dropped;return;}
+        std::array<std::int32_t,64> rows{};
+        for(std::size_t begin=0;begin<frontier;begin+=rows.size()) {
+            const auto count=std::min(rows.size(),frontier-begin);
+            program.source_journal->read_tokens(source.ref,begin,rows.data(),count);
+            if(!std::equal(rows.begin(),rows.begin()+count,cp.prefix.begin()+begin))
+                throw kvmem::MemoryError(kvmem::MemoryErrorCode::Stale,"native checkpoint prefix differs from bound source");
+        }
+        if(result.count==result.checkpoints.size())throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"native checkpoint directory exceeds supported bound");
+        result.checkpoints[result.count++]=pointer.get();
+    };
+    for(const auto& record:window.checkpoints)consider(record.data);
+    for(const auto& entry:window.coverage)consider(entry.record.data);
+    if(!result.count)throw kvmem::MemoryError(kvmem::MemoryErrorCode::Stale,"source has no legal retained checkpoint");
+    return result;
+}
+
+void metadata(Writer& out,const KvmemWindowState& w,const kvmem::SourceState& source,const Directory& dir,
+              const FrozenCheckpoint& frozen,const kvmem::MemoryDescriptor& d) {
+    source_ref(out,source.ref);source_ref(out,source.parent);out.scalar(source.parent_prefix);
+    out.write(source.configuration.data(),source.configuration.size());
+    out.scalar(source.accepted_frontier);out.scalar(source.computed_frontier);out.scalar(source.events);
+    descriptor(out,d);stamp(out,w.stamp);
+    out.scalar(std::uint8_t(bool(w.session_key)));if(w.session_key)text(out,w.session_key->view());
+    out.scalar(w.publication_order);out.scalar(std::uint8_t(w.update_session_index));
+    values(out,w.pages);values(out,w.media_pages);values(out,w.host_versions);values(out,w.retired_pages);values(out,w.gc_protected);
+    out.scalar(std::uint64_t(frozen.pages.size()));for(const auto& page:frozen.pages)out.scalar(std::uint64_t(page.size()));
+    out.scalar(w.historical_think_start);out.scalar(w.payload_bytes);out.scalar(w.spilled_bytes);out.scalar(w.restored_bytes);
+    out.scalar(w.removed_tokens);out.scalar(w.swaps);out.scalar(w.statistics_frontier);
+    w.statistics->snapshot_write(out);
+    const auto& selector=*w.selector;
+    out.scalar(selector.total_tokens());out.scalar(selector.runtime_select_budget_tokens());
+    out.scalar(std::uint64_t(selector.blocks().size()));
+    for(const auto& b:selector.blocks()) {
+        out.scalar(b.block_id);out.scalar(b.orig_pos_start);out.scalar(b.n_tokens);
+        out.scalar(b.attn_score);out.scalar(b.profile_score);out.scalar(b.retrieval_score);
+    }
+    kvmem::write_lrfu(out,selector.retrieval_checkpoint());
+    out.scalar(std::uint64_t(w.query_rows.size()));for(const auto& rows:w.query_rows)values(out,rows);
+    values(out,w.query_sums);graph(out,w.graph);feedback(out,w.feedback.snapshot());scope(out,w.attention_scope);
+    out.scalar(w.output_begin);messages(out,w.request_messages);out.scalar(w.think_open);out.scalar(w.think_close);
+    out.scalar(w.query_tokens);out.scalar(w.query_begin);out.scalar(w.query_end);
+    policy(out,w.coverage.policy());
+    out.scalar(w.capture_plan.next);out.scalar(w.capture_plan.interval);out.scalar(w.capture_plan.root);out.scalar(w.capture_plan.tail);
+    out.scalar(std::uint8_t(w.capture_plan.root_done));out.scalar(std::uint8_t(w.capture_plan.tail_done));
+    out.scalar(w.reuse_anchor);out.scalar(w.reconstruction_frontier);
+    out.scalar(std::uint8_t(w.query_replayed));out.scalar(std::uint8_t(w.query_capture));out.scalar(std::uint8_t(w.query_replay_active));
+    out.scalar(w.query_probe_swaps);values(out,w.query_selected);values(out,w.query_required);
+    out.scalar(std::uint8_t(bool(w.historical_features)));if(w.historical_features)w.historical_features->snapshot_write(out);
+    out.scalar(std::uint8_t(bool(w.historical_thinking)));if(w.historical_thinking)w.historical_thinking->snapshot_write(out);
+    out.scalar(std::uint64_t(dir.count));
+    for(std::size_t i=0;i<dir.count;++i) {
+        const auto& cp=*dir.checkpoints[i];stamp(out,cp.identity.stamp);values(out,cp.prefix);identity(out,cp.prefix_identity);
+        values(out,cp.resident_pages);values(out,cp.mean_tail);kvmem::write_lrfu(out,cp.history);
+        graph(out,cp.graph);feedback(out,cp.feedback);scope(out,cp.attention_scope);
+        const auto image=std::find(frozen.images.begin(),frozen.images.end(),cp.state);
+        if(image==frozen.images.end())throw std::logic_error("unowned native checkpoint image");
+        out.scalar(std::uint64_t(image-frozen.images.begin()));
+    }
+    std::uint64_t records=0;for(const auto& record:w.checkpoints)records+=dir.index(record.data.get())!=UINT64_MAX;
+    out.scalar(records);
+    for(const auto& record:w.checkpoints)if(const auto index=dir.index(record.data.get());index!=UINT64_MAX) {
