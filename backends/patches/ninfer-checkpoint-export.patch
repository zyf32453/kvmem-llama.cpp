+kvmem::SourceArchiveCheckpointWrite ProgramImpl::begin_historical_checkpoint_save(HistoricalSourceRef source) {
+#if defined(__linux__)
+    require_source_control();
+    if(!source_archive || !source_checkpoint_max_bytes || !source_replay_supported())
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"native checkpoint archive is disabled");
+    if(memory_checkpoint_export)
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::Pending,"previous native checkpoint producer still owns its bounded export lease");
+    const kvmem::SourceRef ref{{source.id,source.incarnation},source.revision};
+    const auto state=source_journal->state(ref);
+    const KvmemWindowState* retained=nullptr;
+    for(const auto& window:memory_histories)if(window && window->source==ref &&
+        (!retained || window->publication_order>retained->publication_order))retained=&*window;
+    if(!retained)throw kvmem::MemoryError(kvmem::MemoryErrorCode::Stale,"source has no retained native history");
+    auto input=freeze(*this,*retained,state);
+    memory_checkpoint_export=KvmemCheckpointExportLease::capture(input);
+    try {return source_archive->save_checkpoint(*memory_io,*source_journal,ref,std::move(input));}
+    catch(...) {
+        input={};(void)progress_checkpoint_export();throw;
+    }
+#else
+    (void)source;throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"native checkpoint archive requires Linux");
+#endif
+}
+bool ProgramImpl::progress_checkpoint_export() noexcept {
+    if(!memory_checkpoint_export || !memory_checkpoint_export->ready())return false;
+    memory_checkpoint_export.reset(); // final pinned/metadata release belongs to Engine
+    return true;
+}
+void ProgramImpl::finish_historical_checkpoint_save(const kvmem::SourceArchiveCheckpointWrite& write) {
+#if defined(__linux__)
+    require_source_control();
+    if(!source_archive)throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"no source archive attached");
+    source_archive->publish_checkpoint(write,*source_journal);
+#else
+    (void)write;throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"native checkpoint archive requires Linux");
+#endif
+}
+void ProgramImpl::retire_historical_checkpoint(HistoricalArchiveKey key) {
+#if defined(__linux__)
+    require_source_control();
+    if(!source_archive)throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"no source archive attached");
+    source_archive->retire_checkpoint({key.space,key.id});
+#else
+    (void)key;throw kvmem::MemoryError(kvmem::MemoryErrorCode::Unsupported,"native checkpoint archive requires Linux");
+#endif
+}
