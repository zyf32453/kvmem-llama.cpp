+        require(generated.generated_token_ids==metadata.at("independent_ids").get<std::vector<ninfer::TokenId>>(),"independent restore output changed");
+        std::cout<<nlohmann::json{{"status","passed"},{"mode",mode}}<<std::endl;return 0;
+    }
+    require(mode=="restore" || mode=="fault","unknown mode");
+    const auto parent=engine.import_historical_source(root_key),child=engine.import_historical_source(child_key),other=engine.import_historical_source(other_key);
