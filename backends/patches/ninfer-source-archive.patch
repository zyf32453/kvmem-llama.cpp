+    }
+    if(mode=="deny") {
+        rejected(kvmem::MemoryErrorCode::Stale,[&] { (void)engine.import_historical_source(root_key); });
+        rejected(kvmem::MemoryErrorCode::Stale,[&] { (void)engine.import_historical_source(child_key); });
+        require(engine.historical_archives().size()==1,"persistent forget lost independent archive");
+        const auto other=engine.import_historical_source(other_key);
