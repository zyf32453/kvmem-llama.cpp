+    const auto expected=metadata.at("canonical_ids").get<std::vector<ninfer::TokenId>>();
+    const auto rebuilt=engine.generate(engine.prepare_source_rebuild(parent,1024,32),request());
+    const auto rebuilt_child=engine.generate(engine.prepare_source_rebuild(child,1024,32),request());
+    const auto independent=engine.generate(engine.prepare_source_rebuild(other,512,32),request());
+    require(rebuilt.reused_prompt_tokens==0 && rebuilt.generated_token_ids==expected && rebuilt_child.generated_token_ids==expected,
+        "archive canonical rebuild reused old KV or changed output");
+    require(independent.generated_token_ids==metadata.at("independent_ids").get<std::vector<ninfer::TokenId>>(),"independent rebuild changed output");
+    require(!mtp || (rebuilt.speculative.rounds && rebuilt_child.speculative.rounds),"restored MTP did not speculate");
+    const auto old_sequence=engine.historical_archives().front().saved_sequence;
+    (void)save(parent); require(engine.historical_archives().front().saved_sequence>old_sequence,"restart save did not advance durable version");
+    auto stale_parent=engine.prepare_source_rebuild(parent,1024,32),stale_child=engine.prepare_source_rebuild(child,1024,32);
