+        rejected(kvmem::MemoryErrorCode::Stale,[&] { engine.finish_historical_save(late); });
+    }
+    require(engine.historical_sources().size()==2 && engine.memory_summary().kvmem.retained_sessions==1,"online family not revoked or unrelated data lost");
+    require(engine.memory_summary().kvmem.recovery_bytes==8192,"forget refunded owned prepared data early");
+    rejected(kvmem::MemoryErrorCode::Stale,[&] { (void)engine.generate(std::move(stale_parent),request()); });
+    rejected(kvmem::MemoryErrorCode::Stale,[&] { (void)engine.generate(std::move(stale_child),request()); });
