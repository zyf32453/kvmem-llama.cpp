+        std::scoped_lock execution_lock(execution_mutex_);
+        ensure_resident_locked();
+        std::unique_lock queue_lock(queue_mutex_);
+        if (stopping_ || failed_) throw RequestError(RequestErrorKind::Unavailable,"inference engine is unavailable");
+        if (outstanding_ || materializing_)
+            throw kvmem::MemoryError(kvmem::MemoryErrorCode::Pending,"archive control requires no outstanding requests or unconsumed handles");
+        const auto snapshot = [&] { try { publish_runtime_stats(); } catch (const std::bad_alloc&) {} };
+        try {
+            if constexpr (std::is_void_v<std::invoke_result_t<Work>>) {
+                std::forward<Work>(work)(); queue_lock.unlock(); snapshot(); return;
+            } else {
+                auto result = std::forward<Work>(work)(); queue_lock.unlock(); snapshot(); return result;
+            }
+        } catch (...) {
+            if (queue_lock.owns_lock()) queue_lock.unlock();
