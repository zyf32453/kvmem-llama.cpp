+bool llama_batch_allocr::prepare_historical_simple_input(uint32_t max_tokens) {
+    if (max_tokens == 0 || n_pos_per_embd != 1 || debug != 0) return false;
+    if (prepared_historical_input) return max_tokens <= prepared_historical_max_tokens;
+    clear();
+    prepared_historical_max_tokens = max_tokens;
+    prepared_historical_input = true;
+    try {
+        pos.reserve(max_tokens);
+        n_seq_id.reserve(max_tokens);
+        seq_id.reserve(size_t(max_tokens) + 1);
+        output.reserve(max_tokens);
+        seq_id_unq.reserve(1);
+        used.reserve(max_tokens);
+        out_ids.reserve(max_tokens);
+    } catch (...) {
+        clear_historical_simple_input();
+        throw;
+    }
+    return true;
+}
+
+void llama_batch_allocr::clear_historical_simple_input() noexcept {
+    if (!prepared_historical_input) return;
+    clear();
+    std::vector<llama_pos>().swap(pos);
+    std::vector<int32_t>().swap(n_seq_id);
+    std::vector<llama_seq_id *>().swap(seq_id);
+    std::vector<llama_seq_id>().swap(seq_id_unq);
+    std::vector<int8_t>().swap(output);
+    std::vector<bool>().swap(used);
+    std::vector<int32_t>().swap(out_ids);
+    prepared_historical_input = false;
+    prepared_historical_max_tokens = 0;
+    historical_simple_batch = false;
+}
+
+bool llama_batch_allocr::historical_simple_input_prepared() const noexcept {
