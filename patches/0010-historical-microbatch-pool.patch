 llama_batch_allocr::llama_batch_allocr(uint32_t n_pos_per_embd) : n_pos_per_embd(n_pos_per_embd) {
     const char * LLAMA_BATCH_DEBUG = getenv("LLAMA_BATCH_DEBUG");
@@ -469,10 +470,36 @@ void llama_batch_allocr::split_reset() {
 
     n_used = 0;
 
+#if defined(LLAMA_KVMEM)
+    prepared_simple_next = 0;
+#endif
+
     used.clear();
     used.resize(get_n_tokens(), false);
 }
 
+#if defined(LLAMA_KVMEM)
+bool llama_batch_allocr::use_prepared_simple_pool(
+        std::vector<std::shared_ptr<llama_ubatch::data_t>> * data,
+        std::vector<int32_t> * indices) noexcept {
+    if (!data || !indices || data->empty() || n_pos_per_embd != 1 ||
+        batch.n_tokens <= 0 || !batch.token || batch.embd || batch.embd_nextn) return false;
+    for (int32_t i = 0; i < batch.n_tokens; ++i) {
+        if (batch.n_seq_id[i] != 1 || batch.seq_id[i][0] != 0) return false;
+    }
+    prepared_simple_data = data;
+    prepared_simple_indices = indices;
+    prepared_simple_next = 0;
+    return true;
+}
+
+void llama_batch_allocr::clear_prepared_simple_pool() noexcept {
+    prepared_simple_data = nullptr;
+    prepared_simple_indices = nullptr;
+    prepared_simple_next = 0;
+}
+#endif
