+        if (res) result.graph_meta_bytes += res->get_meta_bytes();
+    }
+    for (uint32_t i = 1; i <= n_decode_graph_slots; ++i) {
+        const auto & res = gf_res_decode[i];
+        result.graph_results[slot] = res.get();
+        result.graph_meta[slot++] = res ? res->get_meta_buffer() : nullptr;
+        if (res) result.graph_meta_bytes += res->get_meta_bytes();
+    }
